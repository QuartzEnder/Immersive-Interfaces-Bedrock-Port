{
  "namespace": "déesse_quickItems",

  "quick_items_button/button":{
    "$use_red_buttons|default":false,
    "variables":{
      "requires": "$use_red_buttons",
      "$default_texture": "textures/déesse_ui/destroy/default_state",
      "$hover_texture": "textures/déesse_ui/destroy/pressed_state"
    }
  },

  "quick_items_stack_button/destroy_mode":{
    "$use_red_buttons":true
  },

  "quick_items_button_content":{
    "$déesse_icon_colour|default":[1.0,1.0,1.0],
    "color": "déesse_icon_colour"
  },

  "add_quick_items_stack_button":{
    "modifications":[
      {
        "array_name":"controls",
        "operation":"replace",
        "control_name": "all_mode",
        "value":{"all_mode@quartz_déesse.all_button_template":{}}
      }
    ]
  },
  
  "add_quick_items_button":{
    "$default_text_color": [1.0,1.0,1.0],
    "$hover_text_color": [1.0,1.0,1.0],
    "$default_checked_text_color": [1.0,1.0,1.0],
    "$hover_checked_text_color": [1.0,1.0,1.0]
  }
}
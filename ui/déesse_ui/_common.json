{
  "namespace": "déesse_common",

  "container_guide_panel":{
    "$background_texture":"textures/ui/recipe/recipe_book_background",
    "$use_large_scroll_box":false
  },

  "container_guide_panel/tab_navigation_panel/navigation_tabs":{
    "offset": [-4,0],
    "$show_deesse_tab_navigation_panel|default":true,
    "visible": "$show_deesse_tab_navigation_panel"
  },

  "edit_box_indent":{
    "$default_edit_box_texture|default":"textures/ui/edit_box_indent",
    "texture":"$default_edit_box_texture",
    "$alternate_edit_box_texture|default":true,
    "variables":{
      "requires": "$alternate_edit_box_texture",
      "$default_edit_box_texture":"textures/ui/generic/text_box_default"
    }
  },

  "edit_box_indent_hover":{
    "$hover_edit_box_texture|default":"textures/ui/edit_box_indent_hover",
    "$alternate_edit_box_texture|default":true,
    "texture": "$hover_edit_box_texture",
    "variables":{
      "requires": "$alternate_edit_box_texture",
      "$hover_edit_box_texture":"textures/ui/generic/text_box_hover"
    }
  },

  "custom_edit_box":{
    "$text_edit_box_label_offset": [2,0]
  },

  "custom_text_edit_box/centering_panel/clipper_panel/magnifying_glass":{
    "$button_texture": "textures/ui/generic/magnifying_glass_no_bg",
    "size": [11,11],
    "$ignore_magnifying_glass|default":true,
    "visible": "(not $ignore_magnifying_glass)"
  },

  "toggle_content@déesse_defs.variables":{
    "$toggle_icon_color":[1.0,1.0,1.0]
  },

  "toggle_content_icon/icon":{
    "color": [1.0,1.0,1.0]
  },

  "toggle_content_icon/icon_clr":{
    "color": [1.0,1.0,1.0]
  },

  "container_guide_title":{
    "offset": [-2,0]
  },

  "icon_content":{
    "color": [1.0,1.0,1.0]
  }
}
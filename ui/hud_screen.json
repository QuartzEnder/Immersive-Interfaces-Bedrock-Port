{
  "namespace": "hud",

  "hud_screen":{
    "$xp_bar_size":[182,8],
    "$all_hotbar_offset":[0,2],
    "$hotbar_grid_offset":[4,14]
  },

  //--------------------------
  // Hotbar
  //--------------------------

  "root_panel":{
    "$xp_control_offset|default": [0,-11.5]
  },

  "centered_gui_elements_at_bottom_middle":{
    "offset": "$all_hotbar_offset"
  },
  
  "centered_gui_elements_at_bottom_middle_touch":{
    "offset": "$all_hotbar_offset"
  },
  "start_cap_image":{
    "alpha": 0
  },
    
  // End of this mess

  "hotbar_renderer":{
    "$hotbar_renderer_size|default": [20,22],
    "layer": 0
  },

  "hotbar_slot_selected_image":{
    //"layer": 8,
    "size": [24,24]
  },

  //---------------------------------
  // Progress Bars
  //--------------------------------

  "empty_progress_bar":{
    "texture": "textures/ui/progress_bars/progress_bar_empty"
  },

  "full_progress_bar":{
    "texture": "textures/ui/progress_bars/progress_bar_full_hud",
    "clip_pixelperfect": true
  },

  "progress_bar_nub":{
    "alpha": 0
  },

  // Whoever designed this tree, may you have warm pillows

  "exp_progress_bar_and_hotbar/resizing_xp_bar_with_hotbar/empty_progress_bar":{
    "size": "$xp_bar_size"
  },

  "exp_progress_bar_and_hotbar/resizing_xp_bar_with_hotbar/empty_progress_bar/full_progress_bar":{
    "size": "$xp_bar_size"
  },

  "exp_progress_bar_and_hotbar/resizing_xp_bar_with_hotbar/empty_progress_bar/full_progress_bar/progress_bar_nub":{
    "size": "$xp_bar_size" // Since I made it invisible it doesn't have any use but I'll still keep it
  },

  "exp_progress_bar_and_hotbar/resizing_xp_bar_with_hotbar/empty_progress_bar/full_progress_bar/progress_bar_nub/horse_jump_rend":{
    "anchor_from":"center",
    "anchor_to":"center",
    "size": "$xp_bar_size"
  },

  "exp_progress_bar_and_hotbar/resizing_xp_bar_with_hotbar/empty_progress_bar/full_progress_bar/progress_bar_nub/horse_jump_rend/dash_rend":{
    "anchor_from":"center",
    "anchor_to":"center",
    "size": "$xp_bar_size",
    "modifications":[
      {
        "array_name":"controls",
        "operation":"insert_back",
        "value":{"hotbar_overlay@quartz_gui.hotbar_overlay":{}}
      }
    ]
  },

  "exp_progress_bar_and_hotbar/resizing_xp_bar_with_hotbar/empty_progress_bar/full_progress_bar/progress_bar_nub/horse_jump_rend/dash_rend/hotbar":{
    "offset": "$hotbar_grid_offset"
  },

  // No hotbar

  "exp_progress_bar_and_hotbar/resizing_hotbar_no_xp_bar":{
    "size": "$xp_bar_size"
  },

  "exp_progress_bar_and_hotbar/resizing_hotbar_no_xp_bar/horse_jump_rend":{
    "size": "$xp_bar_size"
  },

  "exp_progress_bar_and_hotbar/resizing_hotbar_no_xp_bar/horse_jump_rend/dash_rend":{
    "anchor_from":"center",
    "anchor_to":"center",
    "size": "$xp_bar_size",
    "modifications":[
      {
        "array_name":"controls",
        "operation":"insert_back",
        "value":{"hotbar_overlay_no_xp@quartz_gui.hotbar_overlay_no_xp":{}}
      }
    ]
  },

  "exp_progress_bar_and_hotbar/resizing_hotbar_no_xp_bar/horse_jump_rend/dash_rend/hotbar":{
    "offset": "$hotbar_grid_offset"
  },

  "exp_progress_bar_and_hotbar/resizing_hotbar_locator_bar":{
    "anchor_from":"center",
    "anchor_to":"center",
    "size": "$xp_bar_size",
    "modifications":[
      {
        "array_name":"controls",
        "operation":"insert_back",
        "value":{"hotbar_overlay_no_xp@quartz_gui.hotbar_overlay_no_xp":{}}
      }
    ]
  }
}
{
  "namespace": "brewing_stand",

  "brewing_stand_screen":{
    "$background_texture":"textures/ui/brewing/screen_background_brewing",
    "$common_panel_size":[139,80],
    "$common_panel_offset": [-19.5,0],
    "$inventory_background_layer":-5,
    "$close_button_offset":[51.5,5],
    "$big_close_button_offset":[72,0],
    "$is_déesse_ui_pack|default":false,
    "$is_dimz_advanced_container|default":false,

    "$screen_content": "brewing_stand.brewing_stand_panel",
    "$screen_bg_content": "common.screen_background",
    "$screen_background_alpha": 0.4,
    "variables":[
      {
        "requires": "$is_déesse_ui_pack",
        "$close_button_offset":[60.5,0],
        "$cell_image_visible":true
      },
      {
        "requires": "$is_dimz_advanced_container",
        "$close_button_offset":[72.5,-7.5],
        "$big_close_button_offset":[72,-8]
      }
    ]
  },

  "brewing_panel_top_half":{
    "$is_déesse_ui_pack|default":false,
    "offset": [-3,7.5],
    "modifications":[
      {
        "array_name":"controls",
        "operation":"insert_front",
        "value":[
          {
            "déesse_toggle_brewing@quartz_toggles.déesse_toggle_brewing":{
              "anchor_from":"right_middle",
              "anchor_to":"right_middle",
              "offset":[-15,0]
            }
          },
          {"brewing_guide_book_toggle@quartz_brewing.brewing_guide_book_toggle":{}}
        ]
      }
    ]
  },

  "brewing_arrow_full_image":{
    "offset": [15.5,-13]
  },

  "brewing_fuel_bar_full_image":{
    "size": [18,4],
    "offset": [-18,3]
  },
  
  "bottle_empty_image":{
    "visible": false,
    "bindings":[]
  },

  "bubbles_empty_image":{
    "visible": false
  },

  "bubbles_full_image":{
    "offset": [-17,-14]
  },

  "brewing_pipes":{
    "visible": false
  },

  "fuel_empty_image":{
    "visible": false
  },

  "brewing_arrow_empty_image":{
    "visible": false
  },

  "brewing_fuel_bar_empty_image":{
    "visible": false
  },

  "brewing_fuel_pipes":{
    "visible": false
  },

  "brewing_label":{
    "visible": false
  },

  //--------------
  // Slots
  //--------------

  "brewing_stand_pictogram":{
    "offset": [2,0]
  },
  
  "brewing_fuel_slot":{
    "offset": [-62,-18],
    "modifications":[
      {
        "array_name":"controls",
        "operation":"replace",
        "control_name": "fuel_grid_item",
        "value":{
          "fuel_grid_item@common.container_item": {  // the reason of this modification is to eliminate the $cell_overlay_ref variable
            "$item_collection_name": "brewing_fuel_item",

            "$focus_id_binding_type": "none",
            "$focus_id": "brewing_fuel",

            "$focus_override_right_binding_type": "none",
            "$focus_override_right": "brewing_input_item0"
          }
        }    
      }
    ]
  },

  //-------------------------
  // Guide Image Insertion
  //-------------------------

  "brewing_stand_panel/root_panel":{
    "modifications":[
      {
        "array_name":"controls",
        "operation":"insert_front",
        "value":{"brewing_guide_image@quartz_brewing.brewing_guide_image":{}}
      }
    ]
  },

  "brewing_stand_panel/root_panel/furnace_screen_inventory":{
    "anchor_from":"top_left",
    "anchor_to":"top_left",
    "use_anchored_offset":true,
    "property_bag":{
      "#centering_offset_false":0.0,
      "#centering_offset_true":0.27
    },
    "bindings": [
      {
        "binding_type":"view",
        "source_control_name": "brewing_guide_toggle_control",
        "source_property_name": "#toggle_state",
        "target_property_name": "#guide_open"
      },
      {
        "binding_type":"view",
        "source_property_name": "('#centering_offset_' + #guide_open)",
        "target_property_name": "#anchored_offset_value_x"
      }
    ]
  },

  "brewing_stand_panel/root_panel/common_panel":{
    "anchor_from":"top_left",
    "anchor_to":"top_left",
    "use_anchored_offset":true,
    "property_bag":{
      "#centering_offset_false":0.0,
      "#centering_offset_true":0.27
    },
    "bindings": [
      {
        "binding_type":"view",
        "source_control_name": "brewing_guide_toggle_control",
        "source_property_name": "#toggle_state",
        "target_property_name": "#guide_open"
      },
      {
        "binding_type":"view",
        "source_property_name": "('#centering_offset_' + #guide_open)",
        "target_property_name": "#anchored_offset_value_x"
      }
    ]
  }
}
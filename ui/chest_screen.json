{
  "namespace": "chest",

  //---------------------------------------------------------------------
  //Modifications to the general top half of the chests & Title Label
  //---------------------------------------------------------------------
  
  "chest_label":{
    "$show_chest_label|default":false,
    "visible": "$show_chest_label"
  },

  "small_chest_panel":{
    "$show_close_button":true,
    "$inventory_background_layer":-5,
    "$container_title_custom":"$container_title",
    "$anchor_point":"top_middle",
    "$is_déesse_ui_pack|default":false,
    "variables":{
      "requires": "$is_déesse_ui_pack",
      "$close_button_offset":[21.5,-0.5]
    }
  },

  "small_chest_panel_top_half":{
    "offset": [0,-2],
    "layer": 3,
    "modifications":[
      {
        "operation":"insert_back", 
        "array_name":"controls",
        "value":{
          "ender_eye_element@quartz_anim.ender_eye_element":{}
        }
      }
    ]
  },
  
  "small_chest_panel_top_half/small_chest_grid":{
    "offset": "$chest_grid_offset",
    "$chest_grid_offset|default":[0,17],
    "anchor_from":"top_middle",
    "anchor_to":"top_middle"
  },

  //--------------------
  //Large chest panel
  //--------------------

  "large_chest_panel":{
    "$show_close_button":true,
    "$anchor_point":"top_middle",
    "$common_panel_size":[200,159],
    "$common_panel_offset":[0,-22],
    "$inventory_background_layer":-5,
    "$container_title_custom":"$container_title",
    "$is_déesse_ui_pack|default":false,
    "variables":{
      "requires": "$is_déesse_ui_pack",
      "$close_button_offset":[21.5,-0.5]
    }
  },

  "large_chest_panel_top_half":{
    "offset": [0,8]
  },
  
  "large_chest_panel_top_half/chest_label":{
    "offset": [0,-5]
  },
  
  //-----------------------------
  //Particular Chest Containers
  //-----------------------------

  "small_chest_screen":{
    "$show_close_button":true,
    "$common_panel_size":[184,91],
    "$common_panel_offset":[0,-11],
    "$big_close_button_offset":[20,0],
    "$déesse_lowering_padding_size":[1,12],
    "$background_texture":"textures/ui/chest/screen_background_chest",
    "$show_side_help_button":false,
    "$container_title_custom|default":"$container_title",
    "$localization_key":"container.chest",
    "$ignore_eye|default": true,
    "variables": [
      // SCREEN CONTENT
      {
        "requires": "($desktop_screen or $pocket_screen)",
        "$screen_content": "chest.small_chest_panel",
        "$screen_bg_content": "common.screen_background",
        "$background_texture":"textures/ui/chest/screen_background_small_chest",
        "$screen_background_alpha": 0.4
      },
      {
      // DETECT COPPER CHEST
        "requires":"(($container_title_custom = 'container.chestCopper') or ('%.3s' * $container_title_custom = '§n'))"
        //"$background_texture":"textures/ui/copper_chest/screen_background_small_copper_chest"
      }
    ]
  },

  "large_chest_screen":{
    "$has_title_label":false,
    "$big_close_button_offset":[20,0],
    "$déesse_lowering_padding_size":[1,19],
    "$common_panel_size":[200,159],
    "$background_texture":"textures/ui/chest/screen_background_chest",
    "$container_title_custom|default":"$container_title",
    "variables":[
      // SCREEN CONTENT
      {
        "requires": "($desktop_screen or $pocket_screen)",
        "$background_texture":"textures/ui/chest/screen_background_large_chest",
        "$screen_content": "chest.large_chest_panel",
        "$screen_bg_content": "common.screen_background",
        "$screen_background_alpha": 0.4
      },
      {
      // DETECT COPPER CHEST
        "requires": "(($container_title_custom = 'container.chestDoubleCopper') or ('%.3s' * $container_title_custom = '§n'))",
        "$background_texture":"textures/ui/copper_chest/screen_background_large_copper_chest"
      }
    ]
  },

  "large_chest_panel_top_half/large_chest_grid":{
    "offset": [7,7]
  },
  
  "ender_chest_screen":{
    "$chest_label_anchor":"top_left",
    "$chest_label_offset":[8,6],
    "$background_texture":"textures/ui/ender_chest/screen_background_ender_chest",
    "$localization_key":"container.enderchest",
    "$ignore_eye": false,

    "$screen_content": "chest.ender_chest_panel",
    "$screen_bg_content": "common.screen_background",
    "$screen_background_alpha": 0.4,
    "variables":[]
  },

  "barrel_screen":{
    "$chest_label_offset":[0,2],
    "$show_bg_and_shadow":true,
    "$common_panel_size":[176,85],
    "$common_panel_offset":[0,-2],
    "$déesse_lowering_padding_size":[1,15],
    "$chest_grid_offset":[0,18],
    "$background_texture":"textures/ui/barrel/screen_background_barrel",
    "$localization_key":"container.barrel",

    "$screen_content": "chest.barrel_panel",
    "$screen_bg_content": "common.screen_background",
    "$screen_background_alpha": 0.4,
    "variables":[]
  },

  "shulker_box_screen":{
    "$chest_label_offset":[0,3],
    "$show_bg_and_shadow":true,
    "$déesse_lowering_padding_size":[1,22],
    "$chest_grid_offset":[0,19],
    "$common_panel_size":[176,101],
    "$common_panel_offset":[0,0],
    "$background_texture":"textures/ui/shulker/default",
    "$localization_key":"container.shulkerbox",

    "$screen_content": "chest.shulker_box_panel",
    "$screen_bg_content": "common.screen_background",
    "$screen_background_alpha": 0.4,
    "variables":[
        // SCREEN CONTENT HAS BEEN MOVED ABOVE SINCE POCKET UI IS NOT SUPPORTED
      {
        // BLACK
        "requires": "(((%.3s * $container_title_custom) = '§0') or ((%.3s * $container_title_custom) = '§j'))",
        "$background_texture":"textures/ui/shulker/black"
      },
      {
        // BLUE
        "requires": "(((%.3s * $container_title_custom) = '§9') or ((%.3s * $container_title_custom) = '§1'))",
        "$background_texture":"textures/ui/shulker/blue"
      },
      {
        // BROWN
        "requires": "((%.3s * $container_title_custom) = '§n')",
        "$background_texture":"textures/ui/shulker/brown"
      },
      {
        // CYAN
        "requires": "(((%.3s * $container_title_custom) = '§3') or ((%.3s * $container_title_custom) = '§s'))",
        "$background_texture":"textures/ui/shulker/cyan"
      },
      {
        // GREY
        "requires": "((%.3s * $container_title_custom) = '§8')",
        "$background_texture":"textures/ui/shulker/grey"
      },
      {
        // GREEN
        "requires": "(((%.3s * $container_title_custom) = '§2') or ((%.3s * $container_title_custom) = '§q'))",
        "$background_texture":"textures/ui/shulker/green"
      },
      {
        // LIGHT BLUE
        "requires": "((%.3s * $container_title_custom) = '§b')",
        "$background_texture":"textures/ui/shulker/light_blue"
      },
      {
        // LIGHT GREY
        "requires": "(((%.3s * $container_title_custom) = '§7') or ((%.3s * $container_title_custom) = '§h') or ((%.3s * $container_title_custom) = '§i'))",
        "$background_texture":"textures/ui/shulker/light_grey"
      },
      {
        // LIME
        "requires": "((%.3s * $container_title_custom) = '§a')",
        "$background_texture":"textures/ui/shulker/lime"
      },
      {
        // MAGENTA
        "requires": "((%.3s * $container_title_custom) = '§5')",
        "$background_texture":"textures/ui/shulker/magenta"
      },
      {
        // ORANGE
        "requires": "(((%.3s * $container_title_custom) = '§p') or ((%.3s * $container_title_custom) = '§6') or ((%.3s * $container_title_custom) = '§v'))",
        "$background_texture":"textures/ui/shulker/orange"
      },
      {
        // PINK
        "requires": "((%.3s * $container_title_custom) = '§d')",
        "$background_texture":"textures/ui/shulker/pink"
      },
      {
        // PURPLE
        "requires": "((%.3s * $container_title_custom) = '§u')",
        "$background_texture":"textures/ui/shulker/purple"
      },
      {
        // RED
        "requires": "(((%.3s * $container_title_custom) = '§c') or ((%.3s * $container_title_custom) = '§4') or ((%.3s * $container_title_custom) = '§m'))",
        "$background_texture":"textures/ui/shulker/red"
      },
      {
        // WHITE
        "requires": "((%.3s * $container_title_custom) = '§f')",
        "$background_texture":"textures/ui/shulker/white"
      },
      {
        // YELLOW
        "requires": "(((%.3s * $container_title_custom) = '§e') or ((%.3s * $container_title_custom) = '§g'))",
        "$background_texture":"textures/ui/shulker/yellow"
      }
    ]
  }
}
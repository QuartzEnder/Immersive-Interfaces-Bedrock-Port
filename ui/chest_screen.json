{
  "namespace": "chest",

  //---------------------------------------------------------------------
  //Modifications to the general top half of the chests & Title Label
  //---------------------------------------------------------------------
  
  "chest_label":{
    "$show_chest_label|default":false,
    "visible": "$show_chest_label"
  },

  "small_chest_panel":{
    "$show_close_button":true,
    "$inventory_background_layer":-5,
    "$container_title_custom":"$container_title",
    "$anchor_point":"top_middle",
    "$is_déesse_ui_pack|default":false,
    "variables":{
      "requires": "$is_déesse_ui_pack",
      "$close_button_offset":[21.5,-0.5]
    }
  },

  "small_chest_panel_top_half":{
    "offset": [0,-2],
    "layer": 3,
    "modifications":[
      {
        "operation":"insert_back", 
        "array_name":"controls",
        "value":{
          "ender_eye_element@quartz_anim.ender_eye_element":{}
        }
      }
    ]
  },
  
  "small_chest_panel_top_half/small_chest_grid":{
    "offset": "$chest_grid_offset",
    "$chest_grid_offset|default":[0,17],
    "anchor_from":"top_middle",
    "anchor_to":"top_middle"
  },

  //--------------------
  //Large chest panel
  //--------------------

  "large_chest_panel":{
    "$show_close_button":true,
    "$anchor_point":"top_middle",
    "$common_panel_size":[176,138],
    "$common_panel_offset":[0,-2],
    "$inventory_background_layer":-5,
    "$container_title_custom":"$container_title",
    "$is_déesse_ui_pack|default":false,
    "variables":{
      "requires": "$is_déesse_ui_pack",
      "$close_button_offset":[21.5,-0.5]
    }
  },

  "large_chest_panel_top_half":{
    "offset": [0,8]
  },
  
  "large_chest_panel_top_half/chest_label":{
    "offset": [0,-5]
  },

  "large_chest_panel/root_panel/common_panel":{
    //"offset": [0,7]
  },
  
  //-----------------------------
  //Particular Chest Containers
  //-----------------------------

  "small_chest_screen":{
    "$show_close_button":true,
    "$common_panel_size":[184,91],
    "$common_panel_offset":[0,0],
    "$big_close_button_offset":[20,0],
    "$déesse_lowering_padding_size":[1,12],
    "$background_texture":"textures/ui/chest/screen_background_chest",
    "$title_background_texture":"textures/ui/chest/title_background_chest",
    "$container_scroll_box_texture":"textures/ui/chest/scroller",
    "$show_side_help_button":false,
    "$container_title_custom|default":"$container_title",
    "$localization_key":"container.chest",
    "$ignore_eye|default": true,
    "$chest_label_primary_colour":[0.859,0.678,0.322],
    "variables": [
      // SCREEN CONTENT
      {
        "requires": "($desktop_screen or $pocket_screen)",
        "$screen_content": "chest.small_chest_panel",
        "$screen_bg_content": "common.screen_background",
        "$background_texture":"textures/ui/chest/screen_background_small_chest",
        "$screen_background_alpha": 0.4
      },
      {
      // DETECT COPPER CHEST
        "requires":"(($container_title_custom = 'container.chestCopper') or ('%.3s' * $container_title_custom = '§n'))",
        "$background_texture":"textures/ui/copper_chest/screen_background_small_copper_chest",
        "$container_scroll_box_texture":"textures/ui/copper_chest/scroller",
        "$chest_label_primary_colour":[0.887,0.561,0.424]
      }
    ]
  },

  "large_chest_screen":{
    "$chest_label_primary_colour":[0.859,0.678,0.322],
    "$has_title_label":false,
    "$big_close_button_offset":[20,0],
    "$déesse_lowering_padding_size":[1,19],
    "$common_panel_size":[200,159],
    "$background_texture":"textures/ui/chest/screen_background_chest",
    "$title_background_texture":"textures/ui/chest/title_background_chest",
    "$container_title_custom|default":"$container_title",
    "$container_scroll_box_texture":"textures/ui/chest/scroller",
    "variables":[
      // SCREEN CONTENT
      {
        "requires": "($desktop_screen or $pocket_screen)",
        "$background_texture":"textures/ui/chest/screen_background_large_chest",
        "$screen_content": "chest.large_chest_panel",
        "$screen_bg_content": "common.screen_background",
        "$screen_background_alpha": 0.4
      },
      {
      // DETECT COPPER CHEST
        "requires": "(($container_title_custom = 'container.chestDoubleCopper') or ('%.3s' * $container_title_custom = '§n'))",
        "$cell_texture":"textures/ui/copper_chest/cell_copper_chest",
        "$background_texture":"textures/ui/copper_chest/screen_background_large_copper_chest",
        "$container_scroll_box_texture":"textures/ui/copper_chest/scroller",
        "$chest_label_primary_colour":[0.887,0.561,0.424]
      }
    ]
  },

  "large_chest_panel_top_half/large_chest_grid":{
    "offset": [7,7]
  },
  
  "ender_chest_screen":{
    "$chest_label_anchor":"top_left",
    "$chest_label_offset":[8,6],
    "$chest_label_primary_colour":[0.251,0.345,0.392],
    "$background_texture":"textures/ui/ender_chest/screen_background_ender_chest",
    "$title_background_texture":"textures/ui/ender_chest/title_background_ender_chest",
    "$container_scroll_box_texture":"textures/ui/ender_chest/scroller",
    "$localization_key":"container.enderchest",
    "$ignore_eye": false,

    "$screen_content": "chest.ender_chest_panel",
    "$screen_bg_content": "common.screen_background",
    "$screen_background_alpha": 0.4,
    "variables":[]
  },

  "barrel_screen":{
    "$chest_label_offset":[0,2],
    "$show_bg_and_shadow":true,
    "$common_panel_size":[176,85],
    "$déesse_lowering_padding_size":[1,15],
    "$chest_label_primary_colour":[0.482,0.337,0.149],
    "$shadow_colour":[0.851,0.706,0.498],
    "$chest_grid_offset":[0,18],
    "$cell_texture":"textures/ui/barrel/cell_barrel",
    "$background_texture":"textures/ui/barrel/screen_background_barrel",
    "$title_background_texture":"textures/ui/barrel/title_background_barrel",
    "$container_scroll_box_texture":"textures/ui/barrel/scroller",
    "$localization_key":"container.barrel",

    "$screen_content": "chest.barrel_panel",
    "$screen_bg_content": "common.screen_background",
    "$screen_background_alpha": 0.4,
    "variables":[]
  },


{
  "namespace": "horse",

  "horse_screen":{
    "$background_texture":"textures/ui/horse/horse_background",
    "$common_panel_size":[264,119],
    "$common_panel_offset":[0,-23],
    "$main_title_colour":"$generic_main_title_colour",
    "$close_button_offset":[21.5,6.5],

    "$screen_content": "horse.horse_panel",
    "$screen_bg_content": "common.screen_background",
    "$screen_background_alpha": 0.4,
    "variables":[]
  },

  "horse_label":{
    "offset": [7,5]
  },

  "horse_panel":{
    "$is_déesse_ui_pack|default":false,
    "$inventory_background_layer":-1,
    "$déesse_lowering_padding_size":[1,17]
  },

  "horse_panel/root_panel/common_panel":{
    "$use_compact_close_button":false
  },

  "horse_panel/root_panel/equipment":{
    "offset": [6,16]
  },

  "horse_panel/root_panel/renderer":{
    "offset": [28,19]
  },

  "horse_renderer":{
    "size": [45,54]
  },

  "horse_renderer/horse_custom_panel":{
    "size": ["50%","50%"]
  },

  "renderer_bg":{
    "visible": false
  },

  "inv_panel":{
    "offset": [79,17.5]
  },

  "inv_bg_panel":{
    "modifications":[
      {
        "array_name":"controls",
        "operation":"replace",
        "control_name": "cell_image",
        "value":{"horse_chest_background@quartz_gui.horse_chest_background":{}}
      }
    ]
  },

  "equip_grid":{
    "size": [18,36],
    "offset": [1,1],
    "modifications":[
      {
        "array_name":"bindings",
        "operation":"insert_back",
        "value":[
          {
            "binding_name": "#has_only_carpet_slot"
          },
          {
            "binding_name": "#has_carpet_and_saddle_slot"
          },
          {
            "binding_type":"view",
            "source_property_name": "(not (#has_only_carpet_slot or #has_carpet_and_saddle_slot))",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  },

  //-----------------------
  // Equip Sprites
  //-----------------------

  "overlay_image":{
    "alpha": 1
  },

  "saddle_image": {
    "texture": "textures/ui/horse/saddle_slot"
  },

  "horse_armor_image": {
    "texture": "textures/ui/horse/horse_armour_slot"
  },

  "carpet_image": {
    "texture": "textures/ui/horse/llama_carpet_slot",
    "ignored": true
  },

  "nautilus_armor_image": {
    "texture": "textures/ui/horse/horse_armour_slot"
  },

  "equip_panel":{
    "modifications":[
      {
        "array_name":"controls",
        "operation":"insert_back",
        "value":[
          {"llama_carpet_image@quartz_gui.llama_carpet_image":{}},
          {"equip_grid_for_carpet@quartz_gui.equip_grid_for_carpet":{}}
        ]
      }
    ]
  },

  "equip_panel/saddle":{
    "size": [18,18]
  },

  "equip_panel/horse_armor_0":{
    "size": [18,18]
  },

  "equip_panel/carpet_0":{
    "size": [18,18]
  },
  
  "equip_panel/horse_armor_1":{
    "size": [18,18],
    "offset": [1,19]
  },

  "equip_panel/carpet_1":{

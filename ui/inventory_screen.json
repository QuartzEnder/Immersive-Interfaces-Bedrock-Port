{
  "namespace": "crafting",
  
  //---------------------------
  //Cell Image Definition slot
  //----------------------------

  "cell_image_classic":{
    "visible": false,
    "bindings":[]
  },
  
  //------------------------------------
  //Crafting elements
  //------------------------------------

  "filter_toggle":{
    "size": [14,17], // REMEMBER: the size to write here is: size of the texture + 2px
    "anchor_from":"center",
    "anchor_to":"center"
  },

  "crafting_screen":{
    "$background_texture":"textures/ui/crafting/3x3_crafting_bg",
    "$hide_toolbar_panel":true,
    "$common_panel_size":[168,68],
    "$common_panel_offset":[4,12],
    "$anchor_point":"top_middle",
    //"$deesse_inv_instant_anchor":"top_right",
    "$deesse_inv_instant_offset": [-1,-12],
    "$crafting_label_offset":[0,0]
  },
  
  "output_grid_2x2":{
    "size": [16,16]
  },
  
  "crafting_arrow_large":{
    "visible": false
  },
  
  "crafting_panel_top_half":{
    "$show_side_help_button":true,
    "modifications":[
      {
        "array_name":"controls",
        "operation":"insert_back",
        "value":{
          "recipe_toggle_survival@quartz_toggles.recipe_toggle_survival":{
            "$book_visibility_binding_type":"null",
            "$book_anchor_point":"left_middle",
            "$book_offset":[4,2],
            "anchor_from":"$book_anchor_point",
            "anchor_to":"$book_anchor_point",
            "offset":"$book_offset",

            "$is_déesse_ui_pack|default":false,
            "$is_dimz_advanced_container|default":false,

            "variables":{
              "requires":"($is_déesse_ui_pack or $is_dimz_advanced_container)",
              "$book_anchor_point":"bottom_middle",
              "$book_offset":[10,-3]
            }
          }
        }
      },
      {
        "array_name":"controls",
        "operation":"insert_back",
        "value":{"crafting_label@crafting.crafting_label":{}}
      }
    ]
  },

"crafting_label":{
  "visible": false
},

"crafting_grid_3x3_with_label":{
  "modifications":[
    {
      "array_name":"controls",
      "operation":"remove",
      "control_name": "crafting_label"
    }
  ]
},

"work_bench_panel_3x3":{
  "modifications":[
    {
      "operation":"remove",
      "array_name":"controls",
      "control_name": "inventory_label"
    }
  ]
},

"output_grid_3x3":{
  "size": [18,18]
},

"output_grid_3x3/work_bench_output":{
  "size": [18,18],
  "$cell_image_size":[18,18]
},

"work_bench_panel_3x3/work_bench_output_grid":{
  "size": [18,18],
  "offset": [94,34]
},

//----------------------------
// General player inventory
//----------------------------

  "inventory_screen":{
    "$hide_toolbar_panel":false,
    "$background_texture":"textures/ui/crafting/2x2_crafting_bg",
    "$anchor_point":"top_middle",
    "$common_panel_size":[184,115],
    "$common_panel_offset":[0,-25],
    "$deesse_inv_instant_offset":[0,-12]
  },

  "armor_overlay":{
    "alpha": 0
  },

  "offhand_overlay":{
    "alpha": 0
  },

  "player_inventory":{
    "layer": 0
  },

  "player_inventory/common_panel":{
    "offset": "$common_panel_offset",
    "$show_close_button":true
  },

  "player_armor_panel/armor_grid":{
    "offset": [7,7]
  },

  "player_armor_panel/player_bg":{
    "alpha": 0
  },

  "player_armor_panel":{
    "modifications":[
      {
        "array_name":"controls",
        "operation":"remove",
        "control_name": "player_preview_border"
      }
    ]
  },

  "player_armor_panel/offhand_grid":{
    "offset": [76,61]
  },

  "creative_hotbar_panel":{
    "$cell_image_visible":true
  },

  "creative_hotbar_panel/creative_hotbar_background":{
    "texture": "textures/ui/dialog_background_opaque",
    "offset": [0,2],
    "layer": 0
  },

  "crafting_panel_2x2":{
    "$clear_crafting_offset":[-44,-26.5],
    "offset": [1,-1],
    "$is_dimz_advanced_container|default":false,
    "modifications":[
      {
        "array_name":"controls",
        "operation":"insert_back",
        "value":{
          "recipe_toggle_survival@quartz_toggles.recipe_toggle_survival":{
            "anchor_from":"bottom_left",
            "anchor_to":"bottom_left",
            "offset":[11,-3],
            "bindings":[
              {
                "binding_name":"(not #is_creative_mode)",
                "binding_name_override":"visible"
              }
            ]
          }
        }
      }
    ]
  },

  "crafting_panel_2x2/crafting_arrow":{
    "ignored": "(not $is_dimz_advanced_container)"
  },

  "crafting_panel_2x2/survival_crafting_output_grid":{
    "offset": [64,28]
  },

  "crafting_grid_2x2_with_label":{
    "modifications":[
      {
        "array_name":"controls",
        "operation":"replace",
        "control_name": "crafting_label",
        "value":{
          "crafting_label_anchor":{
            "type":"panel",
            "size":[3,1],
            "anchor_from":"top_middle",
            "anchor_to":"top_middle",
            "offset":[-14.5,-1],
            "controls":[{"crafting_label@crafting.crafting_label":{}}]
          }
        }
      }
    ]
},

//---------------------------
// Recipe Book Tabs
//---------------------------

  "tab_content":{
    "$alternate_edit_box_texture":true
  },

  "tab_navigation_panel_layout":{
    "size": [35,"100%"],
    "offset": [3,2],
    "layer": 5
  },

  "tab_content/tab_content_search_bar_panel/vertical_padding_1":{
    "size": [0,0]
  },

  "tab_content/tab_content_search_bar_panel/items_panel":{
    "modifications":[
      {
        "array_name":"controls",
        "operation":"remove",
        "control_name": "shadow_stack"
      }
    ]
  },

  "recipe_book/tab_navigation_panel":{
    "anchor_from":"top_left" ,
    "anchor_to":"top_right",
    "size": [35,"100%"],
    "layer": 9
  },

  "tab_navigation_panel_layout/navigation_tabs/content":{
    "size": [35,"100%"],
    "offset": [4,0],
    "anchor_to":"top_left",
    "anchor_from":"top_left",
    "orientation":"vertical",
    "modifications":[
      {
        "array_name":"controls",
        "operation":"remove",
        "control_name": "fill_panel_0"
      }
    ]
  },

  "tab_navigation_panel_layout/navigation_tabs/content/construction_tab_panel":{
    "size": [35,27]
  },
  "tab_navigation_panel_layout/navigation_tabs/content/equipment_tab_panel":{
    "size": [35,27]
  },
  "tab_navigation_panel_layout/navigation_tabs/content/items_tab_panel":{
    "size": [35,27]
  },
  "tab_navigation_panel_layout/navigation_tabs/content/nature_tab_panel":{
    "size": [35,27]
  },
  "tab_navigation_panel_layout/navigation_tabs/content/search_tab_holder":{
    "size": [35,27]
  },

  "tab_content/tab_content_search_bar_panel/search_and_filter_panel/text_edit_control":{
    "size": ["fill",14],
    "$magnifying_glass_size":[12,12],
    "$magnifying_glass_offset":[0,0],
    "$text_edit_box_label_offset": [2,0],
    "$magnifying_glass_enabled":false,
    "$place_holder_text":"('§r§o§f' + %realmsSettingsScreen.searchBox)",
    "bindings":[
      {
        "binding_name": "#is_left_tab_search",
        "binding_name_override": "#enabled"
      }
    ]
  },

  "construction_tab":{
    "$tab_icon":"quartz_gui.construction_icon_renderer"
  },

  "equipment_tab":{
    "$tab_icon":"quartz_gui.equipment_icon_renderer"
  },

  "items_tab":{
    "$tab_icon":"quartz_gui.items_icon_renderer"
  },

  "nature_tab":{
    "$tab_icon":"quartz_gui.nature_icon_renderer"
  },

//--------------------
// Recipe Book
//--------------------

  "container_overlay_images":{
    "$ignore_plus_icon|default":false
  },

  "item_overlay_expand":{
    "ignored": "$ignore_plus_icon"
  },

  "item_overlay_contract":{
    "ignored": "$ignore_plus_icon"
  },

  "tab_content/tab_content_search_bar_panel/items_panel/scroll_pane":{
    "size": ["100% + 6px","100%"],
    "$show_background":false,
    "$scroll_size":[6,"100%"],
    "$scroll_box_size":[6,"100%"],
    "$scroll_bar_right_padding_size":[1,0],
    "$scroll_track_image_control": "common.empty_panel"
  },

  "recipe_book":{
    "$overwriteable":false,
    "$use_compact_close_button":false,
    "modifications":[
      {
        "array_name":"controls",
        "operation":"replace",
        "control_name": "bg",
        "value":{"bg@quartz_inventory.recipe_book_background":{}}
      },
      {
        "array_name":"controls",
        "operation":"insert_back",
        "value":[
          {
            "big_close_button@quartz_toggles.big_close_button":{
              "anchor_from":"top_right",
              "anchor_to":"top_left",
              "$show_close_button":true,
              "offset":[1,3],
              "bindings":[
                {
                  "binding_name":"#is_creative_layout",
                  "binding_name_override":"#visible"
                }
              ]
            }
          },
          {
            "desktop_close_button@common.close_button":{
              "anchor_from":"top_right",
              "anchor_to":"top_left",
              "ignored": "$pocket_screen",
              "offset": [-1.5,-0.5],
              "bindings":[
                {
                  "binding_name":"#is_creative_layout",
                  "binding_name_override":"#visible"
                }
              ]
            }
          },
          {"creative_search_elements_panel@quartz_inventory.creative_search_elements_panel":{}},
          {"creative_tabs_panel@quartz_inventory.creative_tabs_panel":{}},
          {"creative_recipe_book_layout_toggle@quartz_inventory.creative_recipe_book_layout_toggle":{}},
          {"creative_inventory_layout_toggle@quartz_inventory.creative_inventory_layout_toggle":{}}
        ]
      }
    ]
  },

  "recipe_book/tab_content_panel":{
    "$scrolling_pane_control":"quartz_inventory.custom_inventory_scroll_panel"
  },

  "tab_content/tab_content_search_bar_panel/search_and_filter_panel":{
    "size": ["100% + 1px", 14],
    "bindings":[
      {
        "binding_name": "#is_recipe_book_layout",
        "binding_name_override": "#visible"
      }
    ],
    "modifications":[
      {
        "array_name":"controls",
        "operation":"insert_front",
        "value":{
          "start_padding":{
            "type":"panel",
            "size":[16,1]
          }
        }
      },
      {
        "array_name":"controls",
        "operation":"replace",
        "control_name": "padding_1",
        "value":{
          "end_padding":{
            "type":"panel",
            "size":[15,1]
          }
        }
      }
    ]
  },

  "tab_content/tab_content_search_bar_panel/search_and_filter_panel/filter_toggle_holder":{
    "size": [14,"100%"],
    "bindings":[]
  },

  "tab_content/tab_content_search_bar_panel/search_and_filter_panel/filter_toggle_holder/filter_toggle":{
    "anchor_from":"center",
    "anchor_to":"center",
    "offset": [-4,0.5],
    "bindings":[
      {
        "binding_name":"(not #is_creative_mode)",
        "binding_name_override":"#visible"
      }
    ]
  },

  "tab_content/tab_content_search_bar_panel":{
    "size": ["100% - 24px","100% - 2px"],
    "modifications":[
      {
        "array_name":"controls",
        "operation":"replace",
        "control_name": "creative_label_and_filter_toggle_holder",
        "value":{"empty_spacing_panel":{"type":"panel","size":["100%",10]}}
      }
    ]
  },

  //-----------------------------
  // Scrolling Panel
  //-----------------------------

  // This get used for the creative layout only: the recipe book version is in _quartz_inventory.json

  "scroll_grid_panel":{
    "anchor_from":"top_middle",
    "anchor_to":"top_middle"
  },

  "scroll_grid":{
    "$is_inventory_tab|default":false,
    "$creative_mode":true,
    "anchor_from":"top_middle",
    "anchor_to":"top_middle"
  },

  "grid_item_for_recipe_book":{
    "$scrolling_grid_item_size":[18,18],
    "$cell_image_size":[20,20],
    "$item_renderer_panel_size":[18,18],
    "$item_render_size":[16,16],
    "$ignore_recipe_cell_bindings|default":true
  },

  "recipe_container_cell_images":{
    "texture": "textures/ui/creative/item_slot_bg",
    "bindings":[
      {
        "binding_name": "#container_item_background_texture",
        "binding_name_override": "#texture",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name",
        "binding_condition": "$cell_images_binding_condition",
        "ignored": "$ignore_recipe_cell_bindings" // This is what changed from vanilla
      }
    ]
  },

  "recipe_book_scroll_panel":{
    "size": [180,91],
    "offset": [-5,17],
    "$ignore_plus_icon":false,
    "anchor_from":"top_middle",
    "anchor_to":"top_middle",
    "modifications":[
      {
        "array_name":"bindings",
        "operation":"insert_back",
        "value":{
          "binding_name":"#is_creative_layout",
          "binding_name_override":"#visible"
        }
      }
    ]
  },

//-------------------
// TOOLBAR PANEL
//-------------------

  "toolbar_panel":{
    "$hide_toolbar_panel|default":false,
    "visible": "(not $hide_toolbar_panel)",
    "bindings":[
      {
        "ignored":"$hide_toolbar_panel",
        "binding_name": "#is_creative_mode",
        "binding_name_override": "#visible"
      }
    ]
  },

  "toolbar_panel/toolbar_background":{
    "alpha": 0,
    "propagate_alpha": false,
    "anchor_from":"top_middle",
    "anchor_to":"top_middle"
  },

  
  "toolbar_panel/toolbar_background/toolbar_stack_panel":{
    "modifications":[
      {
        "array_name":"controls",
        "operation":"remove",
        "control_name": "close_button_panel"
      },
      {
        "array_name":"controls",
        "operation":"remove",
        "control_name": "help_button_panel"
      }
    ]
  },

  //--------------------------
  // TOOLBAR PANEL POSITION
  //--------------------------
  
  "recipe_inventory_screen_content/content_stack_panel":{
    "modifications":[
      {
        "array_name":"controls",
        "operation":"remove",
        "control_name": "center_fold"
      },
      {
        "array_name":"controls",
        "operation":"insert_after",
        "control_name": "player_inventory",
        "value":{"centering_padding@quartz_gui.centering_padding":{}}
      }
    ]
  },

  "recipe_inventory_screen_content/content_stack_panel/toolbar_anchor":{
    "modifications":[
      {
        "array_name":"controls",
        "operation":"replace",
        "control_name": "toolbar_panel",
        "value":{"toolbar_panel_centerer@quartz_gui.toolbar_panel_centerer":{}}
      }
    ]
  },

  //---------------------------
  // Advanced Containers
  //---------------------------

  "crafting_arrow_large_icon@crafting.crafting_arrow_icon": {
    "texture": "textures/ui/advanced_container/quick_large_crafting_arrow",
    "size": [9,8]
  },
  
  "crafting_arrow_icon": {
    "texture": "textures/ui/advanced_container/small_white_arrow",
    "size": [5,8],
    "offset": [0,-0.5]
  }
}
{
  "namespace": "quartz_command_block",

  //--------------------------
  // Elements
  //--------------------------

  "command_block_background":{
    "type":"image",
    "bindings":[
      {
        "binding_name": "#block_type_icon_texture"
      },
      {
        "binding_type":"view",
        "source_property_name": "('textures/ui/command_blocks/' + (#block_type_icon_texture - 'textures/ui/'))",
        "target_property_name": "#texture"
      }
    ]
  },

  "custom_command_line_box@command_block.command_block_text_edit_box":{
    "size": [299,20],
    "offset": [13,52.5],
    "anchor_from":"top_middle",
    "anchor_to":"top_middle",
    "$default_edit_box_texture":"textures/ui/generic/text_box_default",
    "$hover_edit_box_texture":"textures/ui/generic/text_box_hover",

    "$focus_id": "command_block_commands_text",
    "focus_change_left": "hover_note_text",
    "focus_change_up": "hover_note_text",
    "max_length": 32500,
    "$text_box_name": "command_block.command_text",
    "$text_edit_box_content_binding_name": "#command_text_edit",
    "$place_holder_text": ""
  },

  //-----------------------------
  // Previous output label
  //-----------------------------

  "show_output_toggle@settings_common.option_toggle": {
    "size": [23,20],
    "offset": [-76.5,14.5],
    "anchor_from":"right_middle",
    "anchor_to":"right_middle",
    "$settings_toggle_alpha":0,
    "$toggle_view_binding_name":"previous_output_toggle",

    "$show_option_label": false,
    "$focus_id": "show_output_toggle",
    "$option_binding_name": "#track_output_binding",
    "$option_enabled_binding_name": "#close_button_visible_binding_name",
    "$toggle_name": "track_output"
  },

  "command_output_text@command_block.command_block_multiline_text_edit_box": {
    "anchor_from": "center",
    "anchor_to": "center",
    "size": [275,20],

    "focus_enabled": false,
    "$text_box_name": "command_block.output_text",
    "max_length": 32500,
    "$text_edit_box_content_binding_name": "#command_output_text",
    "$place_holder_text": "",
    //we dont want selection on the output window
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.menu_select",
        "handle_select": false,
        "handle_deselect": false,
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.menu_ok",
        "handle_select": false,
        "handle_deselect": false,
        "mapping_type": "focused"
      },
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "button.menu_cancel",
        "handle_select": false,
        "handle_deselect": false,
        "mapping_type": "global"
      }
    ]
  },

  "previous_output_label":{
    "type":"label", 
    "offset": [0,-3],
    "anchor_from":"top_left",
    "anchor_to":"bottom_left",
    "$localised_output_label":"advMode.previousOutput",
    "text": "('§9~/§b ' + '%advMode.previousOutput' + ' .bat')",
    "shadow": true,
    "layer": 3,
    "localize": true
  },

  //------------------------------------
  // Command Block Settings Toggles
  //------------------------------------
  
  "block_type_toggle_panel":{
    "type":"stack_panel",
    "size": [100,100],
    "debug":"red",
    "layer": 4,
    "$radio_toggle_group": true,
    "$option_enabled_binding_name": "#block_type_dropdown_enabled",
    "controls": [
      {
        "command_impulse_mode@common_toggles.light_image_toggle": {
          "$toggle_name":"command_block_type",
          "$toggle_state_binding_name": "#command_impulse_mode",
          "$toggle_group_forced_index": 0,
          "size": [100,30]
          //"$radio_label_text": "commandBlockScreen.blockType.impulse"
        }
      },
      {
        "command_chain_mode@common_toggles.light_image_toggle": {
          "size": [100,30],
          "$toggle_name":"command_block_type",
          "$toggle_state_binding_name": "#command_chain_mode",
          "$toggle_group_forced_index": 1
          //"$radio_label_text": "commandBlockScreen.blockType.chain"
        }
      },
      {
        "command_repeat_mode@common_toggles.light_image_toggle": {
          "size": [100,30],
          "$toggle_name":"command_block_type",
          "$toggle_state_binding_name": "#command_repeat_mode",
          "$toggle_group_forced_index": 2
          //"$radio_label_text": "commandBlockScreen.blockType.repeat"
        }
      }
    ]
  },

  //---------------------------
  // Command Block Panel 
  //---------------------------

  "command_block_panel":{
    "type":"panel",
    "layer": 0,
    "$dialog_background":"quartz_command_block.command_block_background",
    "$close_button_offset":[0,0],
    "$common_panel_size":[461,275],
    "controls":[
      {"common_panel@common.common_panel":{"layer": 0}},
      {
        "root_panel":{
          "type":"panel",
          "controls":[
            {"custom_command_line_box@quartz_command_block.custom_command_line_box":{}},
            {"show_output_toggle@quartz_command_block.show_output_toggle":{}},
            {"block_type_toggle_panel@quartz_command_block.block_type_toggle_panel":{}},
            {
              "previous_output_panel":{
                "type":"panel",
                "size": [275,20],
                "offset": [1,12.5],
                "controls":[
                  {"command_output_text@quartz_command_block.command_output_text":{}},
                  {"previous_output_label@quartz_command_block.previous_output_label":{}}
                ],
                "bindings":[
                  {
                    "binding_name": "#command_output_text"
                  },
                  {
                    "binding_type":"view",
                    "source_property_name": "(not (#command_output_text = ''))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
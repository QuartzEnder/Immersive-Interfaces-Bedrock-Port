{
  "namespace": "quartz_command_block",

  //--------------------------
  // Main Elements
  //--------------------------

  "command_block_background":{
    "type":"image",
    "bindings":[
      {
        "binding_name": "#block_type_icon_texture"
      },
      {
        "binding_type":"view",
        "source_property_name": "('textures/ui/command_blocks/' + (#block_type_icon_texture - 'textures/ui/'))",
        "target_property_name": "#texture"
      }
    ]
  },

  "custom_command_line_box@command_block.command_block_text_edit_box":{
    "size": ["fill",20],
    "enabled_newline": false,
    
    "$default_edit_box_texture":"textures/ui/generic/text_box_default",
    "$hover_edit_box_texture":"textures/ui/generic/text_box_hover",
    "$text_box_text_color":"$quartz_grey_colour",

    "$focus_id": "command_block_commands_text",
    "focus_change_left": "hover_note_text",
    "focus_change_up": "hover_note_text",
    "max_length": 32500,
    "$text_box_name": "command_block.command_text",
    "$text_edit_box_content_binding_name": "#command_text_edit",
    "$place_holder_text": ""
  },

  "custom_paste_button@command_block.paste_button":{
    "size": [22,22],
    "layer": 4,

    "$default_button_texture":"textures/ui/generic/text_box_default",
    "$hover_button_texture":"textures/ui/generic/text_box_hover",
    "$pressed_button_texture":"textures/ui/generic/text_box_hover",
    "$default_glyph_color":"$quartz_grey_colour",

    "$button_content":"quartz_command_block.paste_icon"
    
  },

  "custom_plus_button@command_block.plus_button":{
    "size": [22,22],
    "layer": 4,
    "$default_button_texture":"textures/ui/generic/text_box_default",
    "$hover_button_texture":"textures/ui/generic/text_box_hover",
    "$pressed_button_texture":"textures/ui/generic/text_box_hover",
    "$default_glyph_color":"$quartz_grey_colour",

    "$button_content":"quartz_command_block.plus_icon"
  },

  "paste_icon":{
    "type":"image",
    "texture": "textures/ui/command_blocks/paste",
    "size": [8,10]
  },

  "plus_icon":{
    "type":"image",
    "texture": "textures/ui/plus",
    "size": [9,12]
  },

  //-----------------------------
  // Previous output label
  //-----------------------------

  "show_output_toggle@settings_common.option_toggle": {
    "size": [23,20],
    "offset": [-76.5,14.5],
    "anchor_from":"right_middle",
    "anchor_to":"right_middle",
    "$settings_toggle_alpha":0,
    "$toggle_view_binding_name":"previous_output_toggle",

    "$show_option_label": false,
    "$focus_id": "show_output_toggle",
    "$option_binding_name": "#track_output_binding",
    "$option_enabled_binding_name": "#close_button_visible_binding_name",
    "$toggle_name": "track_output"
  },

  "command_output_text@command_block.command_block_multiline_text_edit_box": {
    "anchor_from": "center",
    "anchor_to": "center",
    "size": [275,20],
    "$text_box_text_color":"$quartz_grey_colour",

    "focus_enabled": false,
    "$text_box_name": "command_block.output_text",
    "max_length": 32500,
    "$text_edit_box_content_binding_name": "#command_output_text",
    "$hover_edit_box_texture":"textures/ui/generic/text_box_default",
    "$place_holder_text": "",
    //we dont want selection on the output window
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.menu_select",
        "handle_select": false,
        "handle_deselect": false,
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.menu_ok",
        "handle_select": false,
        "handle_deselect": false,
        "mapping_type": "focused"
      },
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "button.menu_cancel",
        "handle_select": false,
        "handle_deselect": false,
        "mapping_type": "global"
      }
    ]
  },

  "previous_output_label":{
    "type":"label", 
    "offset": [0,-3],
    "anchor_from":"top_left",
    "anchor_to":"bottom_left",
    "$localised_output_label":"advMode.previousOutput",
    "text": "('§9~/§b ' + '%advMode.previousOutput' + ' .bat')",
    "shadow": true,
    "layer": 2
  },

  //-------------------------------
  // Hover Note Text Edit Box
  //-------------------------------

  "hover_note_text@common.text_edit_box": {
    "size": [120,20],
    "$focus_id": "hover_note_text",
    "anchor_from":"left_middle",
    "anchor_to":"left_middle",
    "layer": 5,
    "max_length": 15,
    "$text_box_name": "command_block.hover_note_textbox",
    "$text_edit_box_content_binding_name": "#command_hover_note",
    "$place_holder_text": "commandBlockScreen.hoverNote"
  },

  //------------------------------------
  // Command Block Settings Toggles
  //------------------------------------
  
  "block_type_toggle_panel":{
    "type":"panel",
    "size": [102,22],
    "layer": 4,
    "anchor_from":"top_left",
    "anchor_to":"top_left",
    "$radio_toggle_group": true,
    "$default_texture": "textures/empty",
    "$hover_texture": "textures/empty",
    "$pressed_texture": "textures/empty",
    "$pressed_no_hover_texture": "textures/empty",
    "$unchecked_locked_texture": "textures/empty",
    "$checked_locked_texture": "textures/empty",
    "controls": [
      {
        "command_impulse_mode@common_toggles.light_image_toggle": {
          "$toggle_name":"#command_impulse_mode",
          "$hover_border_visible":false,
          "$default_border_visible":false,
          "$toggle_state_binding_name": "#command_impulse_mode",
          "bindings":[
            {
              "binding_name": "#command_repeat_mode",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "command_chain_mode@common_toggles.light_image_toggle": {
          "$hover_border_visible":false,
          "$default_border_visible":false,
          "$toggle_name":"#command_chain_mode",
          "$toggle_state_binding_name": "#command_chain_mode",
          "bindings":[
            {
              "binding_name": "#command_impulse_mode",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "command_repeat_mode@common_toggles.light_image_toggle": {
          "$hover_border_visible":false,
          "$default_border_visible":false,
          "$toggle_name":"#command_repeat_mode",
          "$toggle_state_binding_name": "#command_repeat_mode",
          "bindings":[
            {
              "binding_name": "#command_chain_mode",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  },

  "conditional_toggle_panel":{
    "type":"panel",
    "size": [102,22],
    "layer": 4,
    "$radio_toggle_group": true,
    "controls": [
      {
        "command_conditional_mode@common_toggles.light_image_toggle": {
          "$toggle_name":"#command_conditional_mode",
          "$toggle_state_binding_name": "#command_conditional_mode",
          "$default_texture": "textures/empty",
          "$hover_texture": "textures/empty",
          "$pressed_texture": "textures/empty",
          "$pressed_no_hover_texture": "textures/empty",
          "$hover_border_visible":false,
          "$default_border_visible":false,
          "bindings":[
            {
              "binding_name": "#command_unconditional_mode",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "command_unconditional_mode@common_toggles.light_image_toggle": {
          "$toggle_state_binding_name": "#command_unconditional_mode",
          "$toggle_name":"#command_unconditional_mode",
          "$default_texture": "textures/ui/command_blocks/comm_conditional",
          "$hover_texture": "textures/ui/command_blocks/comm_conditional",
          "$pressed_texture": "textures/ui/command_blocks/comm_conditional",
          "$pressed_no_hover_texture": "textures/ui/command_blocks/comm_conditional",
          "$hover_border_visible":false,
          "$default_border_visible":false,
          "bindings":[
            {
              "binding_name": "#command_conditional_mode",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  },

  "redstone_toggle_panel":{
    "type":"panel",
    "size": [102,22],
    "layer": 4,
    "anchor_from":"top_right",
    "anchor_to":"top_right",
    "$radio_toggle_group": true,
    "controls":[
      {
        "command_always_on_mode@common_toggles.light_image_toggle": {
          "$toggle_state_binding_name": "#command_always_on_mode",
          "$toggle_name":"#command_always_on_mode",

          "$default_texture": "textures/empty",
          "$hover_texture": "textures/empty",
          "$pressed_texture": "textures/empty",
          "$pressed_no_hover_texture": "textures/empty",
          "$hover_border_visible":false,
          "$default_border_visible":false,

          "bindings":[
            {
              "binding_name": "#command_needs_redstone_mode",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "command_needs_redstone_mode@common_toggles.light_image_toggle": {
          "$toggle_state_binding_name": "#command_needs_redstone_mode",
          "$toggle_name":"#command_needs_redstone_mode",

          "$default_texture": "textures/ui/command_blocks/comm_always_active",
          "$hover_texture": "textures/ui/command_blocks/comm_always_active",
          "$pressed_texture": "textures/ui/command_blocks/comm_always_active",
          "$pressed_no_hover_texture": "textures/ui/command_blocks/comm_always_active",
          "$hover_border_visible":false,
          "$default_border_visible":false,

          "bindings":[
            {
              "binding_name": "#command_always_on_mode",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  },

  "always_active_image":{
    "type":"image",
    "texture": "textures/ui/command_blocks/always_active",
    "size": [90,36],
    "anchor_from":"bottom_left",
    "anchor_to":"bottom_left",
    "offset": [125,-39],
    "layer": 8,
    "bindings":[
      {
        "binding_name": "#command_always_on_mode",
        "binding_name_override": "#visible"
      }
    ]
  },

  "execute_on_first_tick_toggle@settings_common.option_toggle": {
    "anchor_from":"left_middle",
    "anchor_to":"left_middle",
    "offset": [1,2],
    "$option_binding_name": "#execute_on_first_tick",
    "$option_enabled_binding_name": "#execute_on_first_tick_enabled",
    "$show_option_label": false,
    "$toggle_name": "execute_on_first_tick",
    "$toggle_binding_condition": "visible"
  },

  "option_label_execute_on_first_tick": {
    "type": "label",
    "color": "green",
    "size": [ "default", "default" ],
    "layer": 2,
    "text": "commandBlockScreen.executeFirstTick",
    "text_alignment":"right",
    "anchor_from":"right_middle",
    "anchor_to":"right_middle",
    "locked_alpha": 0.5
  },

  "tick_delay_text_box@common.text_edit_box": {
    "size": [60,20],
    "offset": [5,0],
    "$focus_id":"tick_delay_text",
    "layer": 5,
    "max_length": 5,
    "$text_edit_box_text_type": "NumberChars",
    "$text_box_name": "command_block.tick_delay_textbox",
    "$text_edit_box_content_binding_name": "#command_tick_delay",

    "$default_edit_box_texture":"textures/ui/generic/text_box_default",
    "$hover_edit_box_texture":"textures/ui/generic/text_box_hover",
    "$text_box_text_color":"$quartz_grey_colour"
  },

  "option_label_tick_delay": {
    "type": "label",
    "color": "green",
    "size": [ "100%", "default" ],
    "anchor_from":"right_middle",
    "anchor_to":"right_middle",
    "text_alignment":"right",
    "offset": [0,-2],
    "layer": 1,
    "text": "commandBlockScreen.tickDelay",
    "visible": true,
    "locked_alpha": 0.5
  },

  //----------------------------
  // Expanded section
  //----------------------------

  "expanded_command_block_text@command_block.command_block_text_edit_box": {
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "layer": 17,
    "size": ["fill",105],
    "max_length": 32500,
    "$text_box_name": "command_block.command_text",
    "$text_edit_box_content_binding_name": "#command_text_edit",
    "$place_holder_text": "Enter your command input here",
    "$cancel_button_id": "command_block.input_minimize",
    "bindings": [
      {
        "binding_name": "#maximized_input_visible",
        "binding_name_override": "#visible"
      }
    ]
  },

  "minimise_button@common.close_button": {
    "size": [20,20],
    "$close_button_offset": [0,0],
    "$close_button_panel_size": [20,20],
    "debug":"red",
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "command_block.input_minimize",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "command_block.input_minimize",
        "mapping_type": "focused"
      }
    ],
    "controls": [
      {
        "default@common.close_button_panel": {
          "$close_button_texture": "textures/ui/command_blocks/minus_button_default"
        }
      },
      {
        "hover@common.close_button_panel": {
          "$close_button_texture": "textures/ui/command_blocks/minus_button_hover"
        }
      },
      {
        "pressed@common.close_button_panel": {
          "$close_button_texture": "textures/ui/command_blocks/minus_button_hover"
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#minimize_button_visible_binding_name",
        "binding_name_override": "#visible",
        "binding_type": "global"
      }
    ]
  },

  //---------------------------
  // Command Block Panel 
  //---------------------------

  "command_block_panel":{
    "type":"panel",
    "size": [461,275],
    "layer": 0,
    "$dialog_background":"quartz_command_block.command_block_background",
    "$close_button_offset":[-15,35],
    "$big_close_button_offset": [-15,32],
    "$common_panel_size":[461,275],
    "controls":[
      {"common_panel@common.common_panel":{"layer": 0}},
      {
        "root_panel":{
          "type":"panel",
          "size": [461,275],
          "bindings":[
            {
              "binding_name": "(not #maximized_input_visible)",
              "binding_name_override": "#visible"
            }
          ],
          "controls":[
            {
              "top_command_stack_panel":{
                "type":"stack_panel",
                "orientation":"horizontal",
                "size": [299,20],
                "offset": [13,52.5],
                "anchor_from":"top_middle",
                "anchor_to":"top_middle",
                "controls":[
                  {"custom_command_line_box@quartz_command_block.custom_command_line_box":{}},
                  {"padding1":{"type":"panel","size": [3,1]}},
                  {
                    "paste_button_holder":{
                    "type":"panel",
                    "size": [20,20],
                    "controls":[{"custom_paste_button@quartz_command_block.custom_paste_button":{}}]
                    }
                  },
                  {"padding2":{"type":"panel","size": [3,1]}},
                  {
                    "plus_button_holder":{
                      "type":"panel",
                      "size": [20,20],
                      "controls":[{"custom_plus_button@quartz_command_block.custom_plus_button":{}}]
                    }
                  }
                ]
              }
            },
            {
              "first_tick_toggle_panel":{
                "type":"panel",
                "size": [299,"100%c"],
                "offset": [12,-23.5],
                "controls":[
                  {"execute_on_first_tick_toggle@quartz_command_block.execute_on_first_tick_toggle":{}},
                  {"option_label_execute_on_first_tick@quartz_command_block.option_label_execute_on_first_tick":{}}
                ]
              }
            },
            {
              "tick_delay_panel":{
                "type":"panel",
                "size": [299,"100%c"],
                "offset": [13,66.5],
                "anchor_from":"top_middle",
                "anchor_to":"top_middle",
                "controls":[
                  {"tick_delay_text_box@quartz_command_block.tick_delay_text_box":{}},
                  {"option_label_tick_delay@quartz_command_block.option_label_tick_delay":{}},
                  {"hover_note_text@quartz_command_block.hover_note_text":{}}
                ]
              }
            },
            {"show_output_toggle@quartz_command_block.show_output_toggle":{}},
            {
              "previous_output_panel":{
                "type":"panel",
                "size": [275,20],
                "offset": [1,12.5],
                "controls":[
                  {"command_output_text@quartz_command_block.command_output_text":{}},
                  {"previous_output_label@quartz_command_block.previous_output_label":{}}
                ],
                "bindings":[
                  {
                    "binding_name": "#track_output_binding",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "expanded_command_line_panel":{
          "size": [461,275],
          "type":"panel",
          "bindings":[
            {
              "binding_name": "#maximized_input_visible",
              "binding_name_override": "#visible"
            }
          ],
          "controls":[
            {
              "top_command_expanded_stack_panel":{
                "type":"stack_panel",
                "orientation":"horizontal",
                "size": [299,20],
                "offset": [13,52.5],
                "anchor_from":"top_middle",
                "anchor_to":"top_middle",
                "controls":[
                  {"expanded_command_block_text@quartz_command_block.expanded_command_block_text":{}},
                  {"separator_padding":{"type":"panel","size": [3,1]}},
                  {"minimise_button@quartz_command_block.minimise_button":{}}
                ]
              }
            }
          ]
        }
      },
      {
        "command_block_toggles_settings_panel":{
          "type":"panel",
          "size": [310,22],
          "offset": [13.5,42.5],
          "controls":[
            {"block_type_toggle_panel@quartz_command_block.block_type_toggle_panel":{}},
            {"conditional_toggle_panel@quartz_command_block.conditional_toggle_panel":{}},
            {"redstone_toggle_panel@quartz_command_block.redstone_toggle_panel":{}}
          ]
        }
      },
      {
        "always_active_image@quartz_command_block.always_active_image":{}
      }
    ]
  }
}
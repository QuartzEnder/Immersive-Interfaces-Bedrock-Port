{
  "namespace": "quartz_creative",

  
  "recipe_book_background":{
    "type":"panel",
    "debug":"red",
    "controls":[
      {"regular_creative@quartz_creative.regular_creative_bg":{}},
      {"survival_recipe_bg@quartz_creative.survival_recipe_bg":{}}
    ]
  },

  "regular_creative_bg@common.common_panel":{
    "$show_close_button":false,
    "$common_panel_size":[279,152],
    "size": [279,152],
    "anchor_from":"bottom_middle",
    "anchor_to":"bottom_middle",
    "$background_texture":"textures/ui/creative/tab_items",
    "bindings":[
      {
        "binding_name": "#is_creative_layout",
        "binding_name_override": "#visible"
      }
    ]
  },

  "survival_recipe_bg@common.dialog_background_opaque":{
    "size":[147,165],
    "$background_texture":"textures/ui/recipe/recipe_book_background",
    "anchor_from":"top_right",
    "anchor_to":"top_right",
    "layer":8,
    //"offset":[-2,1],
    "bindings":[
      {
        "binding_name":"#is_recipe_book_layout",
        "binding_name_override": "#visible"
      }
    ]
  },

  //-------------------------------------
  // Recipe Survival Scroll Panel
  //-------------------------------------

  "survival_recipe_cell@crafting.grid_item_for_recipe_book":{
    "$scrolling_grid_item_size":[25,25],
    "$cell_image_size":[25,25],
    "$item_renderer_panel_size":[20,20],
    "$item_renderer_size":[16,16]
  },

  "survival_recipe_grid@crafting.scroll_grid":{
    "$creative_mode":false,
    "$grid_item_template": "quartz_creative.survival_recipe_cell",
    "bindings":[
      {
        "binding_name": "#is_recipe_book_layout",
        "binding_name_override": "#visible"
      },
      {
        "binding_name": "#recipe_book_total_items",
        "binding_name_override": "#maximum_grid_items",
        "binding_condition": "$binding_condition",
        "binding_type": "collection",
        "binding_collection_name": "$collection_name"
      }
    ]
  }
}
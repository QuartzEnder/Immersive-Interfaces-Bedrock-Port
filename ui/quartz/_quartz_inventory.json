{
  "namespace": "quartz_inventory",
  
  "recipe_book_background":{
    "type":"panel",
    "controls":[
      {"regular_creative@quartz_inventory.regular_creative_bg":{}},
      {"survival_recipe_bg@quartz_inventory.survival_recipe_bg":{}}
    ]
  },

  "regular_creative_bg@common.common_panel":{
    "$show_close_button":false,
    "$common_panel_size":[279,152],
    "size": [279,152],
    "offset": [-0.5,-14],
    "anchor_from":"bottom_middle",
    "anchor_to":"bottom_middle",
    "$background_texture":"textures/ui/creative/creative_background",
    "bindings":[
      {
        "binding_name": "#is_creative_layout",
        "binding_name_override": "#visible"
      }
    ]
  },

  "survival_recipe_bg@common.dialog_background_opaque":{
    "size":[147,165],
    "$background_texture":"textures/ui/recipe/recipe_book_background",
    "anchor_from":"top_right",
    "anchor_to":"top_right",
    "layer":8,
    "bindings":[
      {
        "binding_name":"#is_recipe_book_layout",
        "binding_name_override": "#visible"
      }
    ]
  },

  //-------------------------------------
  // Recipe Survival Scroll Panel
  //-------------------------------------

  "survival_recipe_cell@crafting.grid_item_for_recipe_book":{
    "$scrolling_grid_item_size":[25,25],
    "$cell_image_size":[25,25],
    "$item_renderer_panel_size":[20,20],
    "$item_renderer_size":[16,16],
    "$ignore_recipe_cell_bindings":false
  },

  "survival_recipe_scroll_grid@crafting.scroll_grid":{
    "$creative_mode":false,
    //"size": ["default","default"],
    "$grid_item_template": "quartz_inventory.survival_recipe_cell",
    "bindings":[
      {
        "binding_name": "#recipe_book_total_items",
        "binding_name_override": "#maximum_grid_items",
        "binding_condition": "$binding_condition",
        "binding_type": "collection",
        "binding_collection_name": "$collection_name"
      }
    ]
  },

  //-------------------------------
  // Scroll Panel for both modes
  //--------------------------------

  "custom_inventory_scroll_panel":{
    "type":"panel",
    "controls":[
      {"recipe_book_scroll_panel@crafting.recipe_book_scroll_panel":{}},
      {"survival_scroll_panel@quartz_inventory.survival_scroll_panel":{}}
    ]
  },

  "survival_scroll_grid_panel@crafting.scroll_grid_panel":{
    "controls":[{"survival_recipe_scroll_grid@quartz_inventory.survival_recipe_scroll_grid":{}}]
  },

  "survival_scroll_panel@crafting.scroll_panel":{
    "$ignore_plus_icon":true,
    "$highlight_slot_texture":"textures/ui/recipe/highlight_slot_recipe",
    "$highlight_slot_size":[24,24],
    "$scrolling_content": "quartz_inventory.survival_scroll_grid_panel",
    "offset": [5.5,1],
    "anchor_from":"top_middle",
    "anchor_to":"top_middle",
    "$collection_name": "recipe_book",
    "size": ["100% + 6px","100% - 35px"],

    "bindings":[
      {
        "binding_name":"#is_recipe_book_layout",
        "binding_name_override":"#visible"
      }
    ]
  },
  
  //----------------------------------
  // Creative Mode Elements
  //----------------------------------

  "creative_search_elements_panel":{
    "type":"panel",
    "controls":[
      {"creative_magnifying_glass_image@quartz_inventory.creative_magnifying_glass_image":{}},
      {"creative_search_bar@quartz_inventory.creative_search_bar":{}}
    ],
    "bindings":[
      {
        "binding_name": "#is_left_tab_search"
      },
      {
        "binding_name": "#is_creative_layout"
      },
      {
        "binding_type":"view",
        "source_property_name": "(#is_left_tab_search and #is_creative_layout)",
        "target_property_name": "#visible"
      }
    ]
  },

  "creative_magnifying_glass_image":{
    "type":"image",
    "texture": "textures/ui/creative/creative_magnifying_glass",
    "size": [41,61],
    "layer": 4,
    "anchor_from":"bottom_right",
    "anchor_to":"bottom_right",
    "offset": [-33,-17]
  },

  "creative_search_bar@common.text_edit_control":{
    "$default_edit_box_texture":"textures/ui/creative/creative_search_box",
    "$hover_edit_box_texture":"textures/ui/creative/creative_search_box",
    "$magnifying_glass_enabled":false,
    "size": [98,14],
    "offset": [-83,18],
    "$text_edit_box_label_offset":[0,0],
    "anchor_from":"top_right",
    "anchor_to":"top_right"
  },

  //---------------------------------
  // Creative Tab Navigation Panel
  //---------------------------------

  "blocks_creative_tab@crafting.construction_tab":{
    "size": [37,31],
    "$unchecked_default_texture": "textures/ui/creative/tab_blocks",
    "$unchecked_hover_texture": "textures/ui/creative/tab_blocks",
    "$checked_default_texture": "textures/ui/creative/tab_blocks_selected",
    "$checked_hover_texture": "textures/ui/creative/tab_blocks_selected",
    "anchor_from":"top_left",
    "anchor_to":"top_left"
  },

  "equipment_creative_tab@crafting.equipment_tab":{
    "size": [30,28],
    "offset": [-56,-1.5],
    "$unchecked_default_texture": "textures/ui/creative/tab_equipment",
    "$unchecked_hover_texture": "textures/ui/creative/tab_equipment",
    "$checked_default_texture": "textures/ui/creative/tab_equipment_selected",
    "$checked_hover_texture": "textures/ui/creative/tab_equipment_selected"
  },

  "items_creative_tab@crafting.items_tab":{
    "size": [32,33],
    "offset": [-29,-1],
    "$unchecked_default_texture": "textures/ui/creative/tab_various",
    "$unchecked_hover_texture": "textures/ui/creative/tab_various",
    "$checked_default_texture": "textures/ui/creative/tab_various_selected",
    "$checked_hover_texture": "textures/ui/creative/tab_various_selected"
  },

  "nature_creative_tab@crafting.nature_tab":{
    "size": [36,31],
    "offset": [-1,-1],
    "$unchecked_default_texture": "textures/ui/creative/tab_nature",
    "$unchecked_hover_texture": "textures/ui/creative/tab_nature",
    "$checked_default_texture": "textures/ui/creative/tab_nature_selected",
    "$checked_hover_texture": "textures/ui/creative/tab_nature_selected"
  },

  "search_creative_tab@crafting.search_tab":{
    "size": [28,30],
    "offset": [0,-5],
    "$unchecked_default_texture": "textures/ui/creative/search_tab",
    "$unchecked_hover_texture": "textures/ui/creative/search_tab",
    "$checked_default_texture": "textures/ui/creative/search_tab_selected",
    "$checked_hover_texture": "textures/ui/creative/search_tab_selected",
    "$tab_icon":"common.empty_panel",
    "anchor_from":"top_right",
    "anchor_to":"top_right",
    "$is_left_most_tab":false,
    "$is_right_most_tab":false
  },

  "creative_tabs_panel":{
    "type":"panel",
    "size": [204,35],
    "offset": [-2,-11],
    "anchor_from":"top_middle",
    "anchor_to":"top_middle",
    "controls":[
      {"blocks_creative_tab@quartz_inventory.blocks_creative_tab":{}},
      {"equipment_creative_tab@quartz_inventory.equipment_creative_tab":{}},
      {"items_creative_tab@quartz_inventory.items_creative_tab":{}},
      {"nature_creative_tab@quartz_inventory.nature_creative_tab":{}},
      {"search_creative_tab@quartz_inventory.search_creative_tab":{}}
    ],
    "bindings":[
      {
        "binding_name": "#is_creative_layout",
        "binding_name_override": "#visible"
      }
    ]
  },

  //-----------------------------------
  // Creative Layout Toggles
  //-----------------------------------

  "creative_recipe_book_layout_toggle@common_toggles.light_image_toggle":{
    "size": [44,51],
    "$toggle_name":"layout_toggle",
    "anchor_from":"top_right",
    "anchor_to":"top_right",
    "$toggle_group_forced_index": "$recipe_book_layout_index",
    "$focus_id": "recipe_book_layout_toggle",
    "$toggle_state_binding_name": "#is_recipe_book_layout",

    "$default_texture": "textures/ui/creative/tab_recipe_book",
    "$hover_texture": "textures/ui/creative/tab_recipe_book_selected",
    "$pressed_texture": "textures/ui/creative/tab_recipe_book",
    "$pressed_no_hover_texture": "textures/ui/creative/tab_recipe_book_selected",
    "$focus_override_up": "FOCUS_OVERRIDE_STOP"

  },

  "creative_inventory_layout_toggle@common_toggles.light_image_toggle":{
    "size": [42,43],
    "$toggle_name":"layout_toggle",
    "anchor_from":"bottom_right",
    "anchor_to":"bottom_right",
    "$toggle_group_forced_index": "$survival_layout_index",
    "$toggle_state_binding_name": "#is_survival_layout",

    "$default_texture": "textures/ui/creative/tab_inv",
    "$hover_texture": "textures/ui/creative/tab_inv_selected",
    "$pressed_texture": "textures/ui/creative/tab_inv",
    "$pressed_no_hover_texture": "textures/ui/creative/tab_inv_selected",
    "$focus_override_up": "FOCUS_OVERRIDE_STOP"
  }
}
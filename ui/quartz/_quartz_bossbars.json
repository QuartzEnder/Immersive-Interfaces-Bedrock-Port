{
  "namespace": "quartz_bossbars",

  //---------------------
  // Bossbar Wrapper
  //---------------------

  "bossbar_wrapper":{
    "type":"panel",
    "controls":[
      {"bossbar_ender@quartz_bossbars.bossbar_ender":{}},
      {"bossbar_wither@quartz_bossbars.bossbar_wither":{}},
      {"bossbar_raid@quartz_bossbars.bossbar_raid":{}}
    ]
  },

  //-------------------
  // Template
  //-------------------

  "template_bossbar_core@common.progress_bar_for_collections":{
    "offset": [0,10],
    "controls": [
      {
        "empty_progress_bar@common.empty_progress_bar": {
          "texture": "$empty_bossbar_texture",
          "layer": 1
        }
      },
      {
        "filled_progress_bar@common.filled_progress_bar_for_collections": {
          "layer": 2,
          "texture": "$filled_bossbar_texture",
          "clip_pixelperfect": false,
          "bindings":[
            {
              "binding_name": "#progress_percentage",
              "binding_type": "collection",
              "binding_collection_name": "$progress_bar_collection",
              "binding_name_override": "#clip_ratio"
            }
          ] 
        }
      }
    ]
  },

  //-----------------------------
  // Boss-specific Bossbars
  //-----------------------------

  "bossbar_ender@quartz_bossbars.template_bossbar_core":{
    "$empty_bossbar_texture":"textures/ui/progress_bars/ender/ender_background_bar",
    "$filled_bossbar_texture":"textures/ui/progress_bars/ender/ender_filled_bar",
    "bindings":[
      {
        "binding_name": "#bossName",
        "binding_type": "collection",
        "binding_collection_name": "boss_bars"
      },
      {
        "binding_type":"view",
        "source_property_name": "(not ((#bossName - '§b§d§r') = #bossName))",
        "target_property_name": "#visible"
      }
    ]
  },

  "bossbar_wither@quartz_bossbars.template_bossbar_core":{
    "$empty_bossbar_texture":"textures/ui/progress_bars/wither/wither_background_bar",
    "$filled_bossbar_texture":"textures/ui/progress_bars/wither/wither_filled_bar",
    "bindings":[
      {
        "binding_name": "#bossName",
        "binding_type": "collection",
        "binding_collection_name": "boss_bars"
      },
      {
        "binding_type":"view",
        "source_property_name": "((#bossName - '§b§c§r' - '§b§d§r') = #bossName)",
        "target_property_name": "#visible"
      }
    ]
  },

  "bossbar_raid@quartz_bossbars.template_bossbar_core":{
    "$empty_bossbar_texture":"textures/ui/progress_bars/raid/raid_background_bar",
    "$filled_bossbar_texture":"textures/ui/progress_bars/raid/raid_filled_bar",
    "bindings":[
      {
        "binding_name": "#bossName",
        "binding_type": "collection",
        "binding_collection_name": "boss_bars"
      },
      {
        "binding_type":"view",
        "source_property_name": "(not ((#bossName - '§b§c§r') = #bossName))",
        "target_property_name": "#visible"
      }
    ]
  }
}
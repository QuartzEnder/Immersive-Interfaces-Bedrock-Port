// mc-disable resourcepack.ui.inheritance.missing
{
  "namespace": "quartz_gui",

  //-----------------------------
  // Cartography rename panel
  //-----------------------------

  "map_rename_panel":{
    "type":"panel",
    "controls":[
      {"text_edit_control@cartography.text_edit_control":{}},
      {"output_description_label@cartography.output_description_label":{
        "offset": [0,-12]
        }
      }
    ],
    "bindings":[
      {
        "binding_name": "#is_rename_mode",
        "binding_name_override": "#visible"
      }
    ]
  },
  
  //-----------------------
  // Tab Icon Renderers
  //-----------------------

  "icon_template_renderer":{
    "type":"custom",
    "renderer":"inventory_item_renderer",
    "size":[16,16],
    "property_bag":{
      "#item_id_aux":"$icon_item_id_aux"
    }
  },

  "construction_icon_renderer@quartz_gui.icon_template_renderer":{
    "$icon_item_id_aux": 2949120  //Brick Block
  },

  "equipment_icon_renderer":{
    "type":"image",
    "size": [16,16],
    "texture": "textures/items/diamond_sword"
  },

  "items_icon_renderer":{
    "type":"image",
    "size": [16,16],
    "texture": "textures/items/redstone_dust"
  },

  "nature_icon_renderer@quartz_gui.icon_template_renderer":{
    "$icon_item_id_aux": 131072   // Grass Block
  },

  //--------------------
  // Horse Elements
  //--------------------

  "horse_chest_background":{
    "type":"image",
    "texture": "textures/ui/horse/chest_background",
    "size": [94,72],
    "offset": [-2,-2.5]
  },

  "horse_slot_bg_panel":{
    "type":"panel",
    "size": [28,50],
    "offset": [-5,-6],
    "anchor_from":"top_left",
    "anchor_to":"top_left",
    "controls":[
      {"horse_single_slot_bg@quartz_gui.horse_single_slot_bg":{}},
      {"horse_double_slot_bg@quartz_gui.horse_double_slot_bg":{}}
    ]
  },

  "horse_single_slot_bg":{
    "type":"image",
    "texture": "textures/ui/horse/single_slot_bg",
    "anchor_from":"top_middle",
    "anchor_to":"top_middle",
    "size": [28,29],
    "offset": [0,1],
    "bindings":[
      {"binding_name": "#has_saddle_slot"},
      {"binding_name": "#has_only_horse_armor_slot"},
      {"binding_name": "#has_only_carpet_slot"},
      {"binding_name": "#has_only_nautilus_armor_slot"},
      {
        "binding_type":"view",
        "source_property_name": "((#has_only_horse_armor_slot or #has_only_carpet_slot or #has_only_nautilus_armor_slot) or (#has_saddle_slot and not (#has_only_horse_armor_slot or #has_only_carpet_slot or #has_only_nautilus_armor_slot)))",
        "target_property_name": "#visible"
      }
    ]
  },

  "horse_double_slot_bg":{
    "type":"image",
    "texture": "textures/ui/horse/double_slot_bg",
    "size": [28,50],
    "anchor_from":"top_middle",
    "anchor_to":"top_middle",
    "bindings":[
      {"binding_name": "#has_horse_armor_and_saddle_slot"},
      {"binding_name": "#has_carpet_and_saddle_slot"},
      {"binding_name": "#has_nautilus_armor_and_saddle_slot"},
      {
        "binding_type":"view",
        "source_property_name": "(#has_horse_armor_and_saddle_slot or #has_carpet_and_saddle_slot or #has_nautilus_armor_and_saddle_slot)",
        "target_property_name": "#visible"
      }
    ]
  },

  //--------------------
  // Villager Sprite
  //--------------------

  "villager_sprite":{
    "type":"image",
    "anchor_from":"bottom_left",
    "anchor_to":"bottom_left",
    "size": [38,39],
    "offset": [-4,0],
    "controls":[
      {"villager_eyes@quartz_anim.villager_eyes":{}}
    ],
    "bindings":[
      {
        "binding_name": "#name_label"
      },
      {
        "binding_type":"view",
        "source_property_name": "((#name_label - '§r') = #name_label)",
        "target_property_name": "#val"
      },
      {
        "binding_type":"view",
        "source_property_name": "('textures/ui/trading/professions/' + (('%.' + 12 * (1 - #val) + 's') * #name_label) + (('%.' + (6 * #val) + 's') * 'backup')))",
        "target_property_name": "#texture"
      }
    ]
  },

  "llama_sprite":{
    "type":"image",
    "texture": "textures/ui/trading/professions/llama",
    "size": [44,45],
    "offset": [3,0],
    "anchor_from":"bottom_right",
    "anchor_to":"bottom_right",
    "bindings":[
      {
        "binding_name": "#name_label"
      },
      {
        "binding_type":"view",
        "source_property_name": "(('%.12s' * #name_label) = '§c§6§1§r')",
        "target_property_name": "#visible"
      }
    ]
  },


  //--------------------------
  // Villager elements
  //--------------------------

  "trading_title_stripe":{
    "type":"image",
    "texture": "textures/ui/trading/trade_title_stripe",
    "size": [84,14],
    "anchor_from":"top_middle",
    "anchor_to":"top_middle",
    "offset": [0,-8],
    "layer": 3,
    "controls":[
      {
        "trading_title_label":{
          "type":"label",
          "text": "trade.trade",
          "localize": true,
          "color": [0,0,0]
        }
      }
    ]
  },

  //-----------------------------------------------
  // Anvil Slot Stack Panel
  //-----------------------------------------------

  "anvil_slot_stack_panel":{
    "type":"stack_panel",
    "size": [125,18],
    "orientation":"horizontal",
    "anchor_from":"bottom_left",
    "anchor_to":"bottom_left",
    "offset": [19,-12],
    "controls":[
      {
        "input_item_slot@anvil.anvil_item_slot": {
          "$item_collection_name": "anvil_input_items",

          "$focus_id_binding_type": "none",
          "$focus_id": "anvil_input",

          "$focus_override_right_binding_type": "none",
          "$focus_override_right": "anvil_material"
        }
      },
      {
        "padding_0":{
          "type":"panel",
          "size": [31,1]
        }
      },
      {
        "material_item_slot@anvil.anvil_item_slot": {
          "$item_collection_name": "anvil_material_items",

          "$focus_id_binding_type": "none",
          "$focus_id": "anvil_material",

          "$focus_override_left_binding_type": "none",
          "$focus_override_left": "anvil_input",

          "$focus_override_right_binding_type": "none",
          "$focus_override_right": "anvil_result"
        }
      },
      {
        "padding_1": {
          "type": "panel",
          "size": [40,1],
          "controls": [
            { "arrow_icon@anvil.arrow_icon": {} },
            {
              "cross_out_icon@anvil.cross_out_icon": {
                "layer": 1
              }
            }
          ]
        }
      },
      {
        "result_item_slot@anvil.anvil_item_slot": {
          "$item_collection_name": "anvil_result_items",
          "$button_ref": "anvil.anvil_output_slot_button",

          "$focus_id_binding_type": "none",
          "$focus_id": "anvil_result",

          "$focus_override_left_binding_type": "none",
          "$focus_override_left": "anvil_material"
        }
      }
    ]
  },

  //---------------------------------
  // Loom Top Half Panel
  //---------------------------------

  "loom_top_half_slots_panel":{
    "type":"panel",
    "size": [148,64],
    "offset": [5,-5],
    "anchor_from":"top_left",
    "anchor_to":"top_left",
    "controls":[
      {
        "input_item_slot@loom.input_item_slot": {
          "anchor_from":"top_left",
          "anchor_to":"top_left",
          "offset": [0,15]
        }
      },
      {
        "dye_item_slot@loom.dye_item_slot":{
          "anchor_from":"top_left",
          "anchor_to":"top_left",
          "offset": [20,15]
        }
      },
      {
        "material_item_slot@loom.material_item_slot":{
          "anchor_from":"bottom_left",
          "anchor_to":"bottom_left",
          "offset": [10,-11]
        }
      },
      {
        "result_item_slot@loom.result_item_slot":{
          "anchor_from":"bottom_right",
          "anchor_to":"bottom_right",
          "offset": [0,1]
        }
      },
      {
        "result_banner_renderer@loom.result_banner_renderer": {
          "layer": 1,
          "anchor_from":"top_right",
          "anchor_to":"top_right",
          "offset": [1,-2]
        }
      }
    ]
  },

  //-------------------------
  // Cartography Lock
  //-------------------------

  "cartography_lock":{
    "type":"image",
    "texture": "textures/ui/cartography/lock",
    "size": [10,14],
    "offset": [-5,-6],
    "anchor_from":"bottom_right",
    "anchor_to":"bottom_right",
    "bindings":[
      {
        "binding_name": "$map_binding_name",
        "binding_name_override": "#visible"
      }
    ]
  },

  //------------------------------------------
  // Template small container Scroll Panel
  //------------------------------------------

  "small_panel_scroll_box":{
    "type":"image",
    "texture": "$small_panel_scroll_box_texture",
    "$has_tiled_scroll_box|default":false,
    "$tiled_scroll_box_size|default":["100%","100%"],
    "$tiled_scroll_box_anchor|default":"center",
    "$tiled_scroll_box_offset|default":[0,0],
    "controls":[
      {
        "tiled_scroll_box_image":{
          "type":"image",
          "texture": "$tiled_scroll_box_texture",
          "size": "$tiled_scroll_box_size",
          "offset": "$tiled_scroll_box_offset",
          "anchor_from":"$tiled_scroll_box_anchor",
          "anchor_to":"$tiled_scroll_box_anchor",
          "$tiled_scroll_box_texture|default":"",
          "tiled": true,
          "ignored": "(not $has_tiled_scroll_box)"
        }
      }
    ]
  },

  "small_container_scroll_panel@common.container_scroll_panel":{
    "$is_small_scrolling_panel":true,
    "$scroll_view_port_offset":[0,0],
    "$use_large_scroll_box":false,
    "$show_background":false,
    "anchor_from":"top_left",
    "anchor_to":"top_left",
    "$scroll_box_size":[12,"100%"],
    "$scroll_size":[12,"100%"],
    "$scroll_size_touch":[12,"100%"],
    "$scroll_box_mouse_image_control": "quartz_gui.small_panel_scroll_box",
    "$scroll_box_touch_image_control": "quartz_gui.small_panel_scroll_box",
    "$scroll_track_image_control": "common.empty_panel"
  },

  //---------------------------------------
  // Loom Scroll Scroll Panel
  //---------------------------------------
  
  "loom_grid_small@loom.scroll_grid":{
    "$grid_item_template|default": "quartz_gui.loom_pattern_button_small"
  },

  "loom_pattern_button_small@loom.pattern_button":{
    "size": [14,14],
    "$background_images|default":"quartz_gui.loom_small_pattern_cell_image"
  },

  "loom_small_pattern_cell_image":{
    "type":"image",
    "layer": 1,
    "bindings": [
      {
        "binding_name": "#pattern_cell_background_texture",
        "binding_type": "collection",
        "binding_collection_name": "$collection_name",
        "binding_condition": "always_when_visible"
      },
      {
        "binding_type":"view",
        "source_property_name": "(#pattern_cell_background_texture + '_loom')",
        "target_property_name": "#texture"
      }
    ]
  },

  "small_loom_scroll_grid_panel":{
    "type": "input_panel",
    "size": [ "100%", "100%c + 2px" ],
    "controls":[{"grid@quartz_gui.loom_pattern_button_small":{}}]
  },

  "loom_scroll_panel@quartz_gui.small_container_scroll_panel":{
    "$highlight_slot_texture":"textures/ui/loom/slot_hover",
    "size": [72,56],
    "offset": [52,-2],
    "$scroll_view_port_size":[60,56],
    "$scroll_view_port_offset":[0,0],
    "$small_panel_scroll_box_texture":"textures/ui/loom/scroller",
    "$collection_name": "patterns",
    "$scrolling_content":"quartz_gui.loom_grid_small"
  },

  //-----------------------------------
  // Stonecutter small scroll panel
  //-----------------------------------

  "stonecutter_cell_image_small":{
    "type": "image",
    "layer": 1,
    "bindings": [
      {
        "binding_name": "#stone_cell_background_texture",
        "binding_type": "collection",
        "binding_collection_name": "$collection_name",
        "binding_condition": "always_when_visible"
      },
      {
        "binding_type":"view",
        "source_property_name": "(#stone_cell_background_texture + '_stone')",
        "target_property_name": "#texture"
      }
    ]
  },

  "stonecutter_button_small@stonecutter.stone_button":{
    "size": [16,18],
    "$background_images|default": "quartz_gui.stonecutter_cell_image_small"
  },

  "stonecutter_scroll_grid_small@stonecutter.scroll_grid":{
    "$grid_item_template|default":"quartz_gui.stonecutter_button_small"
  },

  "stonecutter_scroll_panel@quartz_gui.small_container_scroll_panel":{
    "$has_tiled_scroll_box":true,
    "$tiled_scroll_box_texture":"textures/ui/stonecutter/tiled_scroller",
    "$tiled_scroll_box_size":["100%","100% - 8px"],
    "$tiled_scroll_box_offset":[0,2],
    "$tiled_scroll_box_anchor":"top_middle",

    "$highlight_slot_size":[16,18],
    "$highlight_slot_texture":"textures/ui/stonecutter/slot_hover",
    "size": [81,56],
    "offset": [45,0],
    "layer": 6,
    "$scroll_view_port_size":[66,54],
    "$scroll_view_port_offset":[-1,0],
    "$scroll_track_offset":[-2,0],
    "$small_panel_scroll_box_texture":"textures/ui/stonecutter/scroller",
    "$scrolling_content": "quartz_gui.stonecutter_scroll_grid_small",
    "$collection_name": "stones"
  },

  //---------------------------
  // Recipe Book Background
  //---------------------------

  "recipe_book_background_image":{
    "type":"image",
    "texture": "textures/ui/recipe/recipe_book_background"
  },

  //-----------------------------
  // Anvil State Image
  //-----------------------------

  "anvil_state_image_panel":{
    "type":"panel",
    "size": [172,52],
    "offset": [2,-3.5],
    "controls":[
      {"text_field_anvil_image@quartz_gui.text_field_anvil_image":{}},
      {"anvil_disabled_hammer@quartz_gui.anvil_disabled_hammer":{}},
      {"anvil_error_image@quartz_gui.anvil_error_image":{}}
    ]
  },

  "text_field_anvil_image":{
    "type":"image",
    "texture": "textures/ui/anvil/text_field",
    "size": [172,52],
    "bindings":[
      {
        "binding_name": "#cost_text"
      },
      {
        "binding_name": "#cross_out_icon"
      },
      {
        "binding_type":"view",
        "source_property_name": "((not (#cost_text = '')) or #cross_out_icon)",
        "target_property_name": "#visible"
      }
    ]
  },

  "anvil_disabled_hammer":{
    "type":"image",
    "texture": "textures/ui/anvil/text_field_disabled",
    "size": [55,30],
    "offset": [21,0],
    "anchor_from":"top_left",
    "anchor_to":"top_left",
    "bindings":[
      {
        "binding_name": "#cost_text"
      },
      {
        "binding_name": "#cross_out_icon"
      },
      {
        "binding_type":"view",
        "source_property_name": "((#cost_text = '') and not #cross_out_icon)",
        "target_property_name": "#visible"
      }
    ]
  },

  "anvil_error_image":{
    "type":"image",
    "texture": "textures/ui/anvil/error",
    "anchor_from":"bottom_right",
    "anchor_to":"bottom_right",
    "size": [114,24],
    "offset": [-16,6],
    "bindings": [
      {
        "binding_name": "#cross_out_icon",
        "binding_name_override": "#visible"
      }
    ]
  },

  //---------------------------
  // Shulker bg label
  //---------------------------

  "shulker_label_background":{
    "type":"image",
    "texture": "textures/ui/shulker/label_background",
    "size": ["100% + 10px",14],
    "min_size": [93,14],
    "anchor_from":"top_left",
    "anchor_to":"top_left",
    "offset": [-5,-3],
    "layer": -1
  },

  //------------------------
  // Crafter Redstone
  //------------------------

  "powered_redstone_crafter":{
    "type":"image",
    "texture": "textures/ui/crafter/powered_redstone",
    "size": [15,16],
    "layer": 3,
    "offset": [16.5,-40],
    "bindings":[
      {
        "binding_name": "#redstone_arrow_texture"
      },
      {
        "binding_type":"view",
        "source_property_name": "(#redstone_arrow_texture = 'textures/ui/redstone_arrow_powered')",
        "target_property_name": "#visible"
      }
    ]
  },
  //---------------------------
  // Hotbar Overlay
  //---------------------------

  "hotbar_overlay":{
    "type":"image",
    "texture": "textures/ui/hud/hotbar_overlay",
    "size": ["100% + 10px",35],
    "offset": [0,7.5],
    "layer": -20
  },

  "hotbar_overlay_no_xp@quartz_gui.hotbar_overlay":{
    "texture": "textures/ui/hud/hotbar_overlay_no_xp"
  },

  //---------------------------
  // Mounts Screen Elements
  //---------------------------

  "llama_carpet_image":{
    "type":"image",
    "texture": "textures/ui/horse/llama_carpet_slot",
    "anchor_from":"top_left",
    "anchor_to":"top_left",
    "size": [18,18],
    "offset": [1,19],
    "layer": 4,
    "bindings":[
      {
        "binding_name": "#has_only_carpet_slot"
      },
      {
        "binding_name": "#has_carpet_and_saddle_slot"
      },
      {
        "binding_type":"view",
        "source_property_name": "(#has_only_carpet_slot or #has_carpet_and_saddle_slot)",
        "target_property_name": "#visible"
      }
    ]
  },

  "equip_grid_for_carpet@horse.equip_grid":{
    "size": [18,30],
    "offset": [1,18],
    "bindings":[
      {
        "binding_name": "#equip_grid_dimensions"
      },
      {
        "binding_name": "#has_only_carpet_slot"
      },
      {
        "binding_name": "#has_carpet_and_saddle_slot"
      },
      {
        "binding_type":"view",
        "source_property_name": "(#has_only_carpet_slot or #has_carpet_and_saddle_slot)",
        "target_property_name": "#visible"
      }
    ]
  },

  //--------------------------
  // Left Panel title
  //--------------------------

  "left_panel_title":{
    "type":"image",
    "layer": 3,
    "texture": "textures/ui/generic/text_box_default",
    "size": [82,14],
    "anchor_from":"top_middle",
    "anchor_to":"top_middle",
    "offset": [-7.5,12.5],
    "controls":[
      {
        "left_panel_label":{
          "type":"label",
          "text": "$left_panel_text",
          "size": ["100%","100%"],
          "anchor_from":"top_left",
          "anchor_to":"top_left",
          "offset": [3,3]
        }
      }
    ]
  },

  //---------------------------
  // Furnace door panel
  //---------------------------

  "furnace_door":{
    "type":"image",
    "texture": "$door_texture",
    "size": [24,37],
    "anchor_from":"top_left",
    "anchor_to":"top_left",
    "offset": [26,7],
    "layer": 6,
    "ignored": "$is_furnace_screen"
  }
}
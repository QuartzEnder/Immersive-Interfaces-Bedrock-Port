{
  "namespace": "quartz_anim",

  "general_anim":{
    "anim_type":"aseprite_flip_book",
    "initial_uv":[0,0]
  },

  //------------------
  //Animated Compass
  //------------------

  "animated_compass":{
    "type":"image",
    "size": [21,21],
    "offset": [41,6],
    "texture":"textures/ui/cartography/animated_compass",
    "uv_size":[21,21],
    "layer": 3,
    "anchor_from":"top_left",
    "anchor_to":"top_left",
    "uv":"@quartz_anim.general_anim"
  },

  //------------------------
  // Ender Chest Elements
  //------------------------

  "ender_eye_element":{
    "type":"image",
    "size": [10,10],
    "offset": [0,6],
    "anchor_from":"top_middle",
    "anchor_to":"top_middle",
    "texture": "textures/ui/ender_chest/ender_eye_spritesheet",
    "uv_size": [10,10],
    "uv":"@quartz_anim.general_anim",
    "ignored": "$ignore_eye",
    "layer": 4
  },

  //----------------
  // Dropper
  //----------------

  "animated_dropper":{
    "type":"image",
    "texture": "textures/ui/dropper/animated_dropper",
    "size": [176,74],
    "uv_size": [176,74],
    "uv": "@quartz_anim.general_anim"
  },

  "piston_1":{
    "type":"image",
    "texture": "textures/ui/dropper/piston_1",
    "size": [16,32],
    "uv_size": [16,32],
    "uv": "@quartz_anim.general_anim",
    "anchor_from":"top_right",
    "anchor_to":"top_right",
    "offset": [-28,16]
  },

  "piston_2":{
    "type":"image",
    "texture": "textures/ui/dropper/piston_2",
    "size": [32,16],
    "uv_size": [32,16],
    "uv": "@quartz_anim.general_anim",
    "anchor_from":"bottom_right",
    "anchor_to":"bottom_right",
    "offset": [-28,-8]
  },

  "animated_dropper_panel":{
    "type":"panel",
    "size": [176,74],
    "layer": 3,
    "anchor_from":"top_middle",
    "anchor_to":"top_middle",
    "offset": [0,3],
    "ignored": "(not $is_dropper)",
    "controls":[
      {"animated_dropper@quartz_anim.animated_dropper":{}},
      {"piston_1@quartz_anim.piston_1":{}},
      {"piston_2@quartz_anim.piston_2":{}}
    ],
    "bindings":[
      {
        "binding_type":"view",
        "source_control_name": "quartz_anim_toggle_state",
        "source_property_name": "(not #toggle_state)",
        "target_property_name": "#visible"
      }
    ]
  },
  
  //------------------------
  // Animated Dispenser
  //------------------------

  "animated_dispenser":{
    "type":"image",
    "texture": "textures/ui/dispenser/animated_dispenser",
    "anchor_from":"top_left",
    "anchor_to":"top_left",
    "size": [119,74],
    "uv_size": [119,74],
    "uv": "@quartz_anim.general_anim"
  },

  "dispenser_bow":{
    "type":"image",
    "texture": "textures/ui/dispenser/dispenser_bow",
    "size": [51,68],
    "uv_size": [51,68],
    "uv": "@quartz_anim.general_anim",
    "anchor_from":"right_middle",
    "anchor_to":"right_middle",
    "offset": [0,2]
  },

  "animated_dispenser_panel":{
    "type":"panel",
    "size": [168,"100%cm"],
    "anchor_from":"top_left",
    "anchor_to":"top_left",
    "ignored": "(not $is_dispenser)",
    "offset": [0,3],
    "layer": 3,
    "controls":[
      {"animated_dispenser@quartz_anim.animated_dispenser":{}},
      {"dispenser_bow@quartz_anim.dispenser_bow":{}}
    ],
    "bindings":[
      {
        "binding_type":"view",
        "source_control_name": "quartz_anim_toggle_state",
        "source_property_name": "(not #toggle_state)",
        "target_property_name": "#visible"
      }
    ]
  },

  //-----------------------------------
  // Animated Stonecutter Sawblade
  //-----------------------------------

  "stonecutter_sawblade":{
    "type":"image",
    "texture": "textures/ui/stonecutter/sawblade",
    "size": [155,58],
    "uv_size":[155,58],
    "uv": "@quartz_anim.general_anim",
    "anchor_from":"top_left",
    "anchor_to":"top_left",
    "offset": [10,9],
    "layer": 3,
    "bindings":[
      {
        "binding_type":"view",
        "source_control_name": "quartz_anim_toggle_state",
        "source_property_name": "(not #toggle_state)",
        "target_property_name": "#visible"
      }
    ]
  },

  //----------------------
  // Villager Eyes
  //----------------------

  "villager_eyes":{
    "type":"image",
    "texture": "textures/ui/trading/backup",
    "size": [12,5],
    "uv_size": [12,5],
    "uv":"@quartz_anim.general_anim",
    "anchor_from":"top_middle",
    "anchor_to":"top_middle",
    "offset": [1,12],
    "bindings":[
      {
        "binding_name": "#name_label"
      },
      {
        "binding_type":"view",
        "source_property_name": "((#name_label - '§r') = #name_label)",
        "target_property_name": "#val"
      },
      {
        "binding_type":"view",
        "source_property_name": "('textures/ui/trading/villager_eyes/' + (('%.' + 12 * (1 - #val) + 's') * #name_label) + (('%.' + (6 * #val) + 's') * 'backup')))",
        "target_property_name": "#texture"
      }
    ]
  }
}
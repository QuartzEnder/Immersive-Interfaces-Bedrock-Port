{
  "namespace": "quartz_brewing",

  "brewing_guide_book_toggle@quartz_toggles.recipe_toggle_view_template":{
    "$book_type":"furnace_paper",
    "anchor_from":"left_middle",
    "anchor_to":"left_middle",
    "$is_déesse_ui_pack|default":false,
    "ignored": "($is_déesse_ui_pack)",
    "offset": [0,14],

    "$toggle_name":"brewing_guide_toggle",
    "$toggle_view_binding_name":"brewing_guide_toggle_control"
  },

  "custom_guide_tooltip":{
    "type":"input_panel",
    "size": [0,0],
    "follows_cursor": true,
    "layer": 29,
    "allow_clipping": false,
    "consume_hover_events": false,
    "always_handle_pointer": true,
    "focus_enabled": false,
    "focus_magnet_enabled": false,
    "controls":[
      {
        "tooltip_content_panel":{
          "type":"panel",
          "size": ["100%cm","100%cm"],
          "anchor_from":"bottom_right",
          "anchor_to":"top_left",
          "offset": [8,8],
          "controls":[
            {
              "hover_text_label":{
                "type":"label",
                "text": "$hover_text"
              }
            },
            {
              "tooltip_background":{
                "type":"image",
                "texture": "textures/ui/generic/custom_tooltip",
                "size": ["100%sm + 16px","100%sm + 16px"],
                "layer": -1
              }
            }
          ]
        }
      }
    ]
  },

  //-------------------------
  // Buttons
  //-------------------------

  "brewing_hover_area@common_buttons.light_text_button": {
    "size": [13,13],
    "anchor_from":"top_left",
    "anchor_to":"top_left",
    "$pressed_button_name": "",
    "$border_visible": false,
    "visible": true,
    "focus_enabled": false,
    "controls": [
      {"hover@quartz_brewing.custom_guide_tooltip":{}}
    ]
  },

  "ingredients_hover_area@quartz_brewing.brewing_hover_area":{
    "size": [7,7]
  },

  //-------------------------
  // Template Paddings
  //-------------------------

  "1x1_padding":{
    "type":"panel",
    "size": [1,1]
  },

  "3x1_padding":{
    "type":"panel",
    "size": [3,1]
  },

  "7x1_padding":{
    "type":"panel",
    "size": [7,1]
  },

  "8x1_padding":{

{
  "namespace": "loom",

  "loom_screen":{
    "$screen_content": "loom.loom_panel",
    "$is_dimz_advanced_container|default":false,
    "variables":[
      {
        "requires": "$is_dimz_advanced_container",
        "$close_button_offset":[31.5,19]
      }
    ]
  },

  "right_panel":{
    "$title_background_size":["100% + 12px", 12],
    "$title_background_offset":[0,3],
    "$main_title_colour":[0.639,0.404,0.008],
    "$background_texture":"textures/ui/loom/screen_background_loom",
    "$show_side_help_button":true
  },

  "scroll_panel":{
    "offset": [2,30],
    "anchor_from":"top_middle",
    "anchor_to":"top_middle",
    "size": ["100% - 10px","100% - 50px"]
  },

  "top_half_panel":{
    "modifications":[
      {
        "array_name":"controls",
        "operation":"insert_back",
        "value":{
          "bedrock_large_toggle@quartz_toggles.bedrock_large_toggle":{
            "anchor_from":"top_right",
            "anchor_to":"top_right",
            "offset":[-10,-12]
          }
        }
      },
      {
        "array_name":"controls",
        "operation":"replace",
        "control_name": "top_half_stack_panel",
        "value":{"loom_top_half_slots_panel@quartz_gui.loom_top_half_slots_panel":{}}
      },
      {
        "array_name":"controls",
        "operation":"insert_back",
        "value":{"loom_scroll_panel@quartz_gui.loom_scroll_panel":{}}
      }
    ]
  },

  "right_panel/loom_screen_inventory/loom_label":{
    "offset": [0,-1]
  },

  "pattern_book_panel":{
    "layer": 3,
    "$common_panel_size":[147,165],
    "$overwriteable":false,
    "$background_texture":"textures/ui/recipe/recipe_book_background",
    "$left_panel_text":"('§o' + %itemGroup.name.banner_pattern)",
    "modifications":[
      {
        "array_name":"controls",
        "operation":"insert_back",
        "value":{"left_panel_title@quartz_gui.left_panel_title":{}}
      }
    ],
    "bindings":[
      {
        "binding_type":"view",
        "source_control_name": "left_panel_toggle",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  },

  "center_fold":{
    "size": [2,166],
    "modifications":[
      {
        "array_name":"controls",
        "operation":"remove",
        "control_name": "center_bg"
      }
    ]
  },

  "toolbar_panel":{
    "ignored": true
  },

  "pattern_button":{
    "size": [25,25]
  },

  "right_panel/common_panel":{
    "$show_close_button":true,
    "$common_panel_size":[206,101],
    "$common_panel_offset":[0,-19]
  },

  "loom_label":{
    "visible": false
  },
  
"container_cell_image":{
  "bindings":[
      {
        "binding_name": "#container_cell_background_texture",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name",
        "binding_condition": "$cell_images_binding_condition"
      },
      {
        "binding_type":"view",
        "source_property_name": "(#container_cell_background_texture + '_loom')",
        "target_property_name": "#texture"
      }
    ]
  },

  //---------------------
  // Icons
  //---------------------

  "banner_empty_image":{
    "ignored": true
  },

  "dye_empty_image":{
    "ignored":true
  },

  "pattern_item_empty_image":{
    "ignored":true
  }
}
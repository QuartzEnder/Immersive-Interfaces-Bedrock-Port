{
  "namespace": "stonecutter",

  "stonecutter_screen":{    
    "$screen_content": "stonecutter.stonecutter_panel",
    "$is_dimz_advanced_container|default":false,
    "$close_button_offset":[18.5,-20],
    "$big_close_button_offset":[18.5,-20],
    "variables":[]
  },

  "right_panel":{
    "$background_texture":"textures/ui/stonecutter/screen_background_stonecutter",
    "$common_panel_size":[212,69],
    "$common_panel_offset":[0,26],
    "modifications":[
      {
        "array_name":"controls",
        "operation":"insert_after",
        "control_name": "common_panel",
        "value":{"animated_sawblade_panel@quartz_anim.animated_sawblade_panel":{}}
      },
      {
        "array_name":"controls",
        "operation":"insert_back",
        "value":{
          "anim_toggle_panel@quartz_toggles.anim_toggle_panel":{
            "$anim_toggle_offset":[34.5,27],
            "variables":[
              /*{
                "requires":"$is_déesse_ui_pack",
                "$anim_toggle_offset":[38.5,27],
                "$big_anim_toggle_offset":[27,0]
              },*/
              {
                "requires":"$is_dimz_advanced_container",
                "$anim_toggle_offset":[37.5,43]
              }
            ]
          }
        }
      }
    ]
  },

  "scroll_panel":{
    "offset": [4,30],
    "anchor_from":"top_middle",
    "anchor_to":"top_middle",
    "size": ["100% - 12px","100% - 36px"]
  },

  "stone_book_panel":{
    "layer": 3,
    "$background_texture":"textures/ui/recipe/recipe_book_background",
    "$left_panel_text":"('§o' + %itemGroup.name.stone)",
    "$common_panel_size":[147,165],
    "modifications":[
      {
        "array_name":"controls",
        "operation":"insert_back",
        "value":{"left_panel_title@quartz_gui.left_panel_title":{}}
      }
    ],
    "bindings":[
      {
        "binding_type":"view",
        "source_control_name": "left_panel_toggle",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  },

  "stonecutter_label":{
    "visible": false
  },

  "right_panel/stonecutter_screen_inventory":{
    "modifications":[
      {
        "array_name":"controls",
        "operation":"replace",
        "control_name": "stonecutter_label",
        "value":{
          "title_label_anchor":{
            "type":"panel",
            "size":[1,1],
            "anchor_from":"top_middle",
            "anchor_to":"top_middle",
            "offset":[3.5,0],
            "controls":[{"stonecutter_label@stonecutter.stonecutter_label":{}}]
          }
        }
      }
    ]
  },
  
  "top_half_panel":{
    "modifications":[
      {
        "array_name":"controls",
        "operation":"insert_back",
        "value":{"stonecutter_scroll_panel@quartz_gui.stonecutter_scroll_panel":{}}
      },
      {
        "array_name":"controls",
        "operation":"insert_back",
        "value":{
          "bedrock_large_toggle@quartz_toggles.bedrock_large_toggle":{
            "anchor_from":"top_left",
            "anchor_to":"top_left",
            "offset":[12,-16]
          }
        }
      }
    ]
  },

  "top_half_stack_panel":{
    "layer": 5,
    "size": [141,"100%cm"],
    "anchor_from":"bottom_right",
    "anchor_to":"bottom_right",
    "$stonecutter_stack_panel_offset|default":[-9,-26],
    "$déesse_quick_craft_offset":[0,-43],
    "offset": "$stonecutter_stack_panel_offset",
    "$is_déesse_ui_pack|default":false,
    "modifications":[
      {
        "array_name":"controls",
        "operation":"replace",
        "control_name": "padding_2",
        "value":{
          "déesse_padding":{
            "type":"panel",
            "size":[101,0],
            "visible":"$is_déesse_ui_pack"
          }
        }
      },
      {
        "array_name":"controls",
        "operation":"remove",
        "control_name": "arrow_holder"
      }
    ],
    "variables":{
      "requires": "$is_déesse_ui_pack",
      "$stonecutter_stack_panel_offset":[-9,-22]
    }
  },

  "top_half_stack_panel/padding_1":{
    "size": ["fill",0]
  },

  "arrow_icon":{
    "visible": false
  },

  "right_panel/common_panel":{
    "$show_close_button":true
  },

  "result_item_slot":{
    "size": [18,18],
    "$cell_image_size":[18,18]
  },

  "center_fold":{
    "size": [2,166],
    "modifications":[
      {
        "array_name":"controls",
        "operation":"remove",
        "control_name": "center_bg"
      }
    ]
  },

  "stone_button":{
    "size": [25,25]
  },

  "toolbar_panel":{
    "ignored": true
  }
}
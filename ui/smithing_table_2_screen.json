{
  "namespace": "smithing_table_2",

  "smithing_table_panel":{
    "$background_texture":"textures/ui/smithing/screen_background_smithing",
    "$title_background_texture":"textures/ui/smithing/title_background_smithing",
    "$main_title_colour":[0.157,0.169,0.216],
    "$shadow_colour":[0.404,0.455,0.573]
  },

  "top_half_panel":{
    "modifications":[
      {
        "array_name":"controls",
        "operation":"replace",
        "control_name": "icon_and_text_panel",
        "value":{"upgrade_label@smithing_table_2.upgrade_label":{}}
      }
    ]
  },

  "toolbar_panel":{
    "ignored": true
  },

  "smithing_icon":{
    "visible": false
  },

  "smithing_table_panel/root_panel":{
    "modifications":[
      {
        "array_name":"controls",
        "operation":"remove",
        "control_name": "toolbar_anchor"
      }
    ]
  },

  "smithing_table_panel/root_panel/common_panel":{
    "$show_close_button":true,
    "$show_side_help_button":true
  },

  "upgrade_label":{
    "color": "$main_title_colour",
    "text": "container.smithing_table",
    "$parent_text":"container.smithing_table",
    "offset": [0,-6],
    "size": ["default","default"],
    "anchor_from":"top_middle",
    "anchor_to":"top_middle",
    "modifications":[
      {
        "array_name":"controls",
        "operation":"insert_back",
        "value":{"title_background_and_shadow@quartz_gui.title_background_and_shadow":{}}   
      }
    ]
  },

  "recipe_grid":{
    "size": ["100%",18],
    "offset": [81,-11],
    "anchor_from":"bottom_left",
    "anchor_to":"bottom_middle"
  },

  "arrow_icon":{
    "visible": false
  }
}
{
  "namespace": "beacon",

  "beacon_screen":{
    "$background_texture":"textures/ui/beacon/screen_background_beacon",
    
    "$screen_content": "beacon.beacon_panel",
    "$screen_bg_content": "common.screen_background",
    "$screen_background_alpha": 0.4,
    "$is_dimz_advanced_container|default":false,
    "variables":[
      {
        "requires": "$is_dimz_advanced_container",
        "$close_button_offset":[42.5,-0.5]
      }
    ]
  },

  //----------------
  // PANELS
  //----------------

  "beacon_panel/root_panel":{
    "$show_close_button":true,
    "size": [256,219],
    "$common_panel_size":[259,195],
    "$common_panel_offset":[6.5,-25],
    "$inv_background_texture":"textures/ui/beacon/beacon_inventory",
    "$is_déesse_ui_pack|default":false,
    "$anchor_point":"top_middle",
    "variables":{
      "requires": "$is_déesse_ui_pack",
      "$common_panel_offset":[0,28]
    }
  },

  "beacon_panel/root_panel/beacon_inventory":{
    "modifications":[
      {
        "array_name":"controls",
        "operation":"replace",
        "where":{"control_name":"inventory_panel_bottom_half"},
        "value":{"inventory_panel_bottom_half_with_label@common.inventory_panel_bottom_half_with_label":{"$background_offset":[120,40]}}
      }
    ]
  },

  "beacon_inner_panel":{
    "alpha": 0,
    "modifications":[
      {
        "array_name":"controls",
        "operation":"remove",
        "control_name": "middle_strip"
      },
      {
        "array_name":"controls",
        "operation":"remove",
        "control_name": "pyramid_panel"
      },
      {
        "array_name":"controls",
        "operation":"remove",
        "control_name": "primary_power_label"
      },
      {
        "array_name":"controls",
        "operation":"remove",
        "control_name": "secondary_power_label"
      }
    ]
  },

  //--------------------
  // PAYMENT PANEL
  //--------------------

  "payment_panel":{
    "anchor_from":"top_left",
    "anchor_to":"top_left"
  },

  "beacon_panel/root_panel/beacon_inventory/payment_panel":{
    "offset": [0,107]
  },

  "payment_panel/cancel_panel":{
    "$image_size":[12,12]
  },

  "usable_items_panel":{
    "visible": false
  },

  //---------------------------
  // Beacon Buttons
  //---------------------------

  "toggle_button":{
    "size": [28,28]
  },

  "toggle_template":{
    "modifications":[
      {
        "array_name":"controls",
        "operation":"remove",
        "control_name": "$image_control"
      }
    ]
  },

  "button_unchecked_default":{
    "texture": "$default_beacon_texture"
  },

  "button_unchecked_hover":{
    "texture": "$hover_beacon_texture"
  },

  "button_checked":{
    "texture": "$selected_beacon_texture"
  },

  "button_checked_hover":{
    "texture": "$selected_beacon_texture"
  },

  "button_locked":{
    "texture": "$locked_beacon_texture"
  },

  "button_locked_hover":{
    "texture": "$locked_beacon_texture"
  },

  "button_panel/speed_panel":{
    "$default_beacon_texture":"textures/ui/beacon/normal/speed",
    "$hover_beacon_texture":"textures/ui/beacon/hover/speed",
    "$selected_beacon_texture":"textures/ui/beacon/selected/speed",
    "$locked_beacon_texture":"textures/ui/beacon/locked/speed"
  },

  "button_panel/haste_panel":{
    "$default_beacon_texture":"textures/ui/beacon/normal/haste",
    "$hover_beacon_texture":"textures/ui/beacon/hover/haste",
    "$selected_beacon_texture":"textures/ui/beacon/selected/haste",
    "$locked_beacon_texture":"textures/ui/beacon/locked/haste"
  },

  "button_panel/resist_panel":{
    "$default_beacon_texture":"textures/ui/beacon/normal/resistance",
    "$hover_beacon_texture":"textures/ui/beacon/hover/resistance",
    "$selected_beacon_texture":"textures/ui/beacon/selected/resistance",
    "$locked_beacon_texture":"textures/ui/beacon/locked/resistance"
  },

  "button_panel/jump_panel":{
    "$default_beacon_texture":"textures/ui/beacon/normal/jump_boost",
    "$hover_beacon_texture":"textures/ui/beacon/hover/jump_boost",
    "$selected_beacon_texture":"textures/ui/beacon/selected/jump_boost",
    "$locked_beacon_texture":"textures/ui/beacon/locked/jump_boost"
  },

  "button_panel/strength_panel":{
    "$default_beacon_texture":"textures/ui/beacon/normal/strength",
    "$hover_beacon_texture":"textures/ui/beacon/hover/strength",
    "$selected_beacon_texture":"textures/ui/beacon/selected/strength",
    "$locked_beacon_texture":"textures/ui/beacon/locked/strength"
  },

  "button_panel/regen_panel":{
    "$default_beacon_texture":"textures/ui/beacon/normal/regeneration",
    "$hover_beacon_texture":"textures/ui/beacon/hover/regeneration",
    "$selected_beacon_texture":"textures/ui/beacon/selected/regeneration",
    "$locked_beacon_texture":"textures/ui/beacon/locked/regeneration"
  },

    "button_panel/extra_panel":{
    "$default_beacon_texture":"textures/ui/beacon/normal/overlay_2",
    "$hover_beacon_texture":"textures/ui/beacon/hover/overlay_2",
    "$selected_beacon_texture":"textures/ui/beacon/selected/overlay_2",
    "$locked_beacon_texture":"textures/ui/beacon/locked/overlay_2"
  }
}
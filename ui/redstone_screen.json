{
  "namespace": "redstone",

  "panel/root_panel/common_panel":{
    "layer": 2
  },

  "redstone_input_grid":{
    "offset": "$grid_offset_override",
    "anchor_from":"top_middle",
    "anchor_to":"top_middle",
    "$grid_offset_override|default":"$grid_offset"
  },

  "item_dropper_label":{
    "visible": false
  },
  
  //---------------
  // Dropper
  //---------------

  "dropper_screen":{
    "$close_button_offset|default":[75,-0.5],
    "$grid_offset_override":[0,9],
    "$is_dropper":true,
    "$background_texture":"textures/ui/dropper/screen_background_dropper",
    "$common_panel_size":[78,112],
    "$common_panel_offset":[0,-32],

    "$screen_label": "redstone.dropper_label",
    "$screen_dimensions": [ 176, 166 ],
    "$grid_dimensions": [ 3, 3 ],
    "$grid_offset": [ 0, 0 ],
    "$screen_content": "redstone.panel",
    "$screen_bg_content": "common.screen_background",
    "$screen_background_alpha": 0.4,
    "variables":[]
  },

  //---------------
  // Dispenser
  //---------------

  "dispenser_screen":{
    "$close_button_offset|default":[75,-0.5],
    "$grid_offset_override":[0,9],
    "$is_dispenser":true,
    "$background_texture":"textures/ui/dispenser/screen_background_dispenser",
    "$common_panel_size":[78,112],
    "$common_panel_offset":[0,-32],

    "$screen_label": "redstone.dispenser_label",
    "$screen_dimensions": [ 176, 166 ],
    "$grid_dimensions": [ 3, 3 ],
    "$grid_offset": [ 0, 0 ],
    "$screen_content": "redstone.panel",
    "$screen_bg_content": "common.screen_background",
    "$screen_background_alpha": 0.4,
    "variables":[]
  },

  //---------------
  // Hopper
  //---------------

  "hopper_screen":{
    "$close_button_offset":[36.5,-0.5],
    "$grid_offset_override":[0,12],
    "$title_background_size":["100% + 12px", 12],
    "$title_background_offset":[0,3],
    "$common_panel_offset":[0,15],
    "$common_panel_size":[138,32],
    "$not_dispenser":true,
    "$not_dropper":true,
    "$is_hopper":true,
    "$background_texture":"textures/ui/hopper/screen_background_hopper",

    "$screen_label": "redstone.hopper_label",
    "$screen_dimensions": [ 176, 133 ],
    "$grid_dimensions": [ 5, 1 ],
    "$grid_offset": [ 0, -7 ],
    "$screen_content": "redstone.panel",
    "$screen_bg_content": "common.screen_background",
    "$screen_background_alpha": 0.4,
    "variables":[]
  },

  "hopper_label":{
    "offset": [0,-1],
    "$title_background_size":["100% + 12px", 12],
    "anchor_from":"top_middle",
    "anchor_to":"top_middle"
  },

  //---------------
  // Crafter
  //---------------

  "crafter_screen":{
    "$background_texture":"textures/ui/crafter/screen_background_crafter",
    "$common_panel_size":[172,92],
    "$common_panel_offset":[5,-12],

    "$screen_label": "redstone.crafter_label",
    "$screen_dimensions": [ 176, 166 ],
    "$grid_dimensions": [ 3, 3 ],
    "$grid_offset": [ 0, 0 ],
    "$screen_content": "redstone.panel_crafter",
    "$screen_bg_content": "common.screen_background",
    "$screen_background_alpha": 0.4,
    "variables":[]
  },

  "panel_crafter/root_panel/common_panel":{
    "layer": 2
  },

  "crafter_label":{
    "visible": false
  },

  "cell_image":{
    "visible": "$debug_release_immersive_interfaces_quartz",
    "$cell_image_alpha|default":1,
    "$cell_image_colour|default":[1,1,1],
    "color": "$cell_image_colour",
    "alpha": "$cell_image_alpha",
    "texture": "$cell_texture",
    "$cell_texture|default": "textures/ui/slot_enabled",
    "variables":{
      "requires": "$debug_release_immersive_interfaces_quartz",
      "$cell_image_alpha":0.3,
      "$cell_image_colour":[0,1,0],
      "$cell_texture":"textures/ui/cell_image"
    }
  },

  //----------------------------------------------------------------------------------------
  // Disabled slots & Grid - Mojang couldn't you wrap these slots in a panel???
  //----------------------------------------------------------------------------------------

  "crafter_highlight_slot":{
    "texture": "textures/ui/highlight_slot",
    "size": [24,24],
    "uv_size": [24,24],
    "uv": "@quartz_anim.general_anim"
  },

  "crafter_disabled_slot/hover":{
    "texture": "textures/ui/crafter/highlight_slot_disabled",
    "size": [24,24],
    "uv_size": [24,24],
    "uv": "@quartz_anim.general_anim"
  },


  "panel_crafter/root_panel/redstone_screen_inventory":{
    "modifications":[
      {
        "array_name":"controls",
        "operation":"replace",
        "control_name": "redstone_wire_line",
        "value":{"powered_redstone_crafter@quartz_gui.powered_redstone_crafter":{}}
      }
    ]
  },

  "crafter_input_grid":{
    "anchor_from":"top_middle",
    "anchor_to":"top_middle",
    "offset": [0,5]
  },

  "output_slot_hover_info":{
    "offset": [54,-41],
    "modifications":[
      {
        "array_name":"controls",
        "operation":"remove",
        "control_name": "output_slot_border"
      }
    ]
  },

  "panel_crafter/root_panel/disabled_slot_0_button":{
    "offset": [-54,-58]
  },

  "panel_crafter/root_panel/disabled_slot_1_button":{
    "offset": [-36,-58]
  },

  "panel_crafter/root_panel/disabled_slot_2_button":{
    "offset": [-18,-58]
  },

  "panel_crafter/root_panel/disabled_slot_3_button":{
    "offset": [-54,-40]
  },

  "panel_crafter/root_panel/disabled_slot_4_button":{
    "offset": [-36,-40]
  },

  "panel_crafter/root_panel/disabled_slot_5_button":{
    "offset": [-18,-40]
  },

  "panel_crafter/root_panel/disabled_slot_6_button":{
    "offset": [-54,-22]
  },

  "panel_crafter/root_panel/disabled_slot_7_button":{
    "offset": [-36,-22]
  },

  "panel_crafter/root_panel/disabled_slot_8_button":{
    "offset": [-18,-22]
  }
}
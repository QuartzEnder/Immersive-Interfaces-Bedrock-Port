{
  "namespace": "enchanting",

///---------------------------------
/// TRANSFORMING THE COMMON PANEL
///---------------------------------

  "enchanting_panel":{
    "$show_close_button":true,
    "$use_compact_close_button":false
  },

  "enchant_runes":{
    "size": [74,16],
    "offset": [22,4]
  },

  "enchanting_screen":{
    "$inventory_background_layer":-5,
    "$title_background_offset":[0,2],
    "$title_background_size":["100% + 12px", 12],
    "$background_texture":"textures/ui/enchanting/screen_background_enchanting",
    "$close_button_offset":[22,3],
    "$main_container_colour":[0.192,0.098,0.188],
    "$is_déesse_ui_pack|default":false,
    "$is_dimz_advanced_container|default":false,
    "$common_panel_size":[176,90],
    "$common_panel_offset":[-3,8],

    "$screen_content": "enchanting.enchanting_panel",
    "$screen_bg_content": "common.screen_background",
    "$screen_background_alpha": 0.4,

    "variables":[
      {
        "requires": "$is_dimz_advanced_container",
        "$close_button_offset":[21.5,0]
      }
    ]
  },

//-------------------
/// ELEMENT CHANGES
//-------------------

  "lapis_image":{
    "visible": false
  },

  "enchanting_label":{
    "visible": false
  },

  "dust_image":{
    "size": [16,16]
  },

  "dust_panel":{
    "size": ["default",52]
  },

  "enchanting_panel_top_half/item_grid":{
    "anchor_from":"top_left",
    "anchor_to":"top_left",
    "offset": [14,39]
  },

  "enchanting_panel_top_half/lapis_grid":{
    "anchor_from":"top_left",
    "anchor_to":"top_left",
    "offset": [34,39]
  },

  "enchant_button_panel":{
    "size": [108,19]
  },

  "enchanting_panel_top_half/grid_panel/enchantments_grid":{
    "size": [108,57]
  },

  "enchanting_panel_top_half/grid_panel":{
    "anchor_from":"top_right",
    "anchor_to":"top_right",
    "size": [110,59],
    "offset": [-6,6],
    "modifications":[
      {
        "array_name":"controls",
        "operation":"remove",
        "control_name": "indent"
      }
    ]
  },

  // Button Backgrounds

  "dark_background":{
    "ignored": true
  },

  "active_background":{
    "ignored": true
  },

  "background_with_hover_text":{
    "alpha": 0
  },

  //---------------
  // Hover Text
  //---------------

  "background_with_hover_text/hover_text": {
    "bindings": [
      {
        "binding_name": "#hover_text",
        "binding_name_override": "#text_custom",
        "binding_collection_name": "#enchant_buttons",
        "binding_type": "collection"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#text_custom - '§o')",
        "target_property_name": "#hover_text"
      }
    ]
  },

  //-----------------
  // Déesse UI
  //-----------------

  "enchant_reveal_toggle@déesse_toggles.saved_state_content_toggle":{
    "anchor_from":"top_right",
    "anchor_to":"top_right",
    "offset": [0,0]
  },

  "c_enchant_runes_text":{
    "$colord|default": "$enchanting_runes_color"
  },

  "enchant_t_content":{
    "color": [1.0,1.0,1.0]
  }
}